+    public static int exactHandWin(final Player ai) {
+        for (final Card c : ai.getCardsIn(ZoneType.Battlefield)) {
+            for (final Trigger t : c.getTriggers()) {
+                if (t.getMode() != TriggerType.Phase || !"Upkeep".equals(t.getParam("Phase")) || !"Hand".equals(t.getParam("PresentZone"))) continue;
+                final String cmp = t.getParamOrDefault("PresentCompare", "");
+                if (!cmp.startsWith("EQ")) continue;
+                try {
+                    boolean wins = false;
+                    for (SpellAbility x = t.ensureAbility(); x != null && !wins; x = x.getSubAbility()) wins = x.getApi() == ApiType.WinsGame;
+                    if (wins) return Integer.parseInt(cmp.substring(2));
+                } catch (RuntimeException e) { /* skip */ }
+            }
+        }
+        return 0;
+    }
