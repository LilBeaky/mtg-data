+    /** The pips themselves (see neededColors). */
+    static List<Integer> neededPips(final Player ai, final SpellAbility paying) {
+        final List<Integer> out = new ArrayList<>();
+        if (ai == null || paying == null || !forge.ai.ability.DrawAi.pilotSeat(ai) || !real(ai.getGame())) {
+            return out;
+        }
+        try {
+            final Card host = paying.getHostCard();
+            final Object[] c = active(ai) ? CACHE.get(ai) : null;
+            if (c != null && String.valueOf(c[0]).startsWith(phaseKey(ai))) {
+                final Plan p = (Plan) c[1];
+                for (final Step s : p.steps) if (host == null || s.card.getId() != host.getId()) out.addAll(s.pips);   // by id: the spell being cast is a copy
+                if (host == null || !host.getName().equals(p.answer)) out.addAll(p.keepPips);
+            } else {
+                final java.util.function.Function<Player, String> ha = HOLD_ANSWER;
+                final String answer = ha == null ? null : ha.apply(ai);
+                if (answer != null && (host == null || !host.getName().equals(answer))) {
+                    for (final Card h : ai.getCardsIn(ZoneType.Hand)) {
+                        final SpellAbility hs = h.getName().equals(answer) ? firstSpell(ai, h) : null;
+                        if (hs != null) { out.addAll(pips(ai, hs)); break; }
+                    }
+                }
+            }
+        } catch (final RuntimeException e) {
+            out.clear();
+        }
+        return out;
+    }
+
+    /** fishpond patch 88: untapped plain sources (no mana in their cost) to keep out of this payment so the rest of the plan's
+     *  colors stay payable: a matching of those pips to sources, taking first the sources least useful to the spell being
+     *  paid for (then the most specific). Empty when nothing is needed or the pips can't all be held. ComputerUtilMana holds
+     *  them only if the spell can still be paid without them (a Signet fed from the Plains, not the Island). */
+    public static List<Card> holdForPlan(final Player ai, final SpellAbility paying) {
+        final List<Card> out = new ArrayList<>();
+        final List<Integer> rest = neededPips(ai, paying);
+        if (rest.isEmpty()) {
+            return out;
+        }
+        int spell = 0;
+        for (final int pip : pips(ai, paying)) spell |= pip;
+        final List<Card> srcs = new ArrayList<>();
+        final List<Integer> masks = new ArrayList<>();
+        for (final Card c : ai.getCardsIn(ZoneType.Battlefield)) {
+            if (c.isTapped() || paying.getHostCard() != null && c.getId() == paying.getHostCard().getId()) continue;
+            int mask = 0;
+            for (final SpellAbility ma : c.getManaAbilities()) {
+                try {
+                    ma.setActivatingPlayer(ai);
+                    if (ma.getManaPart() == null || ma.getPayCosts().hasManaCost() || !ma.canPlay()) continue;
+                    mask |= colorsOf(ma.getManaPart(), ma);
+                } catch (final RuntimeException e) { /* skip */ }
+            }
+            if (mask != 0) { srcs.add(c); masks.add(mask); }
+        }
+        final int sp = spell;
+        final List<Integer> order = new ArrayList<>();
+        for (int i = 0; i < srcs.size(); i++) order.add(i);
+        order.sort(Comparator.comparingInt((Integer i) -> Integer.bitCount(masks.get(i) & sp)).thenComparingInt(i -> Integer.bitCount(masks.get(i))));
+        final List<Integer> units = new ArrayList<>();
+        for (final int i : order) units.add(masks.get(i));
+        final int[] owner = new int[units.size()];
+        Arrays.fill(owner, -1);
+        for (int i = 0; i < rest.size(); i++) {
+            if (!augment(i, rest, units, owner, new boolean[units.size()])) {
+                return out;
+            }
+        }
+        for (int j = 0; j < units.size(); j++) if (owner[j] >= 0) out.add(srcs.get(order.get(j)));
+        return out;
+    }
