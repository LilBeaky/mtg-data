+    /** fishpond patch 88: the colors (a mask of pip bits) the rest of this turn's plan and the held answer still need, besides
+     *  the spell being paid for, so Forge's mana payment taps the sources that don't make them first (the plan fit Glen
+     *  Elendra and Personal Tutor together; Forge paid Glen's generic with the blue the tutor needed, three turns running,
+     *  zur5b_20261022 game 0). The last plan made this phase (no rebuild mid-payment); outside the plan, the held answer. */
+    static final ThreadLocal<SpellAbility> PAYING = new ThreadLocal<>();   // the spell a nested payment (a Signet's {1}) is for
+
+    public static int neededColors(final Player ai, SpellAbility paying) {
+        if (paying != null && paying.isManaAbility()) {
+            paying = PAYING.get();   // a mana ability's own cost (Orzhov Signet's {1}) is paid for the spell it makes mana for
+        } else if (paying != null) {
+            PAYING.set(paying);
+        }
+        int m = 0;
+        for (final int pip : neededPips(ai, paying)) m |= pip;
+        return m;
+    }
