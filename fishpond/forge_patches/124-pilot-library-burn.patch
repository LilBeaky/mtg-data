+    /** Cards one ability chain takes from its controller's library (patch 124). Draws count only with withDraws; a dig
+     *  counts what it doesn't put back, a reveal what a later step moves to hand or graveyard (Unesh's two piles). */
+    static int libraryBurn(final Card host, final SpellAbility first, final boolean withDraws) {
+        int n = 0;
+        for (SpellAbility a = first; a != null; a = a.getSubAbility()) {
+            final ApiType api = a.getApi();
+            final String def = a.getParamOrDefault("Defined", "You");
+            if (api == ApiType.Draw) {
+                if (withDraws) {
+                    n += drawsForCaster(host, a);
+                }
+            } else if (api == ApiType.Dig && "You".equals(def) && !a.usesTargeting()) {
+                final int dig = amount(host, a, "DigNum", 1);
+                n += "Library".equals(a.getParamOrDefault("DestinationZone2", "Library")) ? Math.min(dig, amount(host, a, "ChangeNum", 1)) : dig;
+            } else if (api == ApiType.PeekAndReveal && "You".equals(def) && !a.usesTargeting()) {
+                for (SpellAbility b = a.getSubAbility(); b != null; b = b.getSubAbility()) {
