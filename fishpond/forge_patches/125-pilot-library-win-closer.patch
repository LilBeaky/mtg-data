+    // ---- fishpond patch 125: a permanent that wins on an empty-library draw (Jace, Wielder of Mysteries; Laboratory Maniac) is
+    // a closer once the library is near its end: 15 cards, or three rounds of the seat's own draws (AiController.roundDraws:
+    // Consecrated Sphinx, extra draw steps) when that is more. The plan valued Jace as a planeswalker (118-136, Swiftfoot Boots
+    // 110) and left it out turn after turn: baral_p124's first 150 games held it 2+ turns with mana unused in 39 games, 8 of the
+    // 13 decking losses among them. A card that wins as it enters (Thassa's Oracle) is patch 10's; one already out needs none.
+    static final boolean LIBRARY_WIN_NEAR = !"false".equals(System.getProperty("fishpond.libraryWinNear"));
+
+    static boolean emptyLibraryWinNear(final Player ai, final Card c, final SpellAbility sa) {
+        if (!LIBRARY_WIN_NEAR || !sa.isSpell() || !c.isPermanent() || c.isInZone(ZoneType.Battlefield) || ai.cantWin()
+                || !forge.ai.ability.DrawAi.emptyLibraryWinCard(c) || AiController.winsOnEntering(c)
+                || ComputerUtil.winsOnEmptyLibraryDraw(ai)) return false;
+        final int lib = ai.getCardsIn(ZoneType.Library).size();
+        return lib <= Math.max(15, 3 * AiController.roundDraws(ai));
+    }
+
     static Step step(final AiController aic, final Player ai, final Card c, final SpellAbility sa) {
