+    // ---- fishpond patch 26: mulligans (the user's floor and commander-cost scaling, 2026-10-07) ----
+    // Forge only threw back 0-1 land or 6+ land hands. A pilot seat keeps a hand only if it meets the user's floor (3+
+    // lands, or 2 lands and 2+ mana of ramp castable off them) and isn't flooded (6+ lands); with the free first mulligan
+    // a 7-card hand must also project to cast a commander costing 4+ on time: target turn 4 for 4 mana, turn 5 for 5+,
+    // allowing one turn late. The projection: lands in hand plus the lands the deck should draw (its land share of the
+    // library per draw, no more than one land a turn), plus ramp mana, minus cost reducers that apply to the commander.
+    // 6 cards: the floor only; 5 or fewer: keep with 2+ lands. -Dfishpond.mulligan=false restores Forge's rule;
+    // each decision prints #FP-MULL.
+    public static boolean pilotMulliganOn() {
+        return !"false".equals(System.getProperty("fishpond.mulligan"));
+    }
+
+    /** Mana a ramp card adds once it resolves (0 for cost reducers). */
+    static int rampMana(final Card c) {
+        if (c.isPermanent() && !c.getManaAbilities().isEmpty()) {
+            int best = 1;
+            for (final SpellAbility m : c.getManaAbilities()) {
+                try {
+                    best = Math.max(best, m.amountOfManaGenerated(true));
+                } catch (RuntimeException e) {
+                    // unknown amount: count one
+                }
+            }
+            return Math.min(best, 3);
+        }
+        if (!c.isPermanent()) {
+            return 1;   // a land put onto the battlefield
+        }
+        return 0;
+    }
+
+    /** How much c's cost-reduction statics would take off the commander's cost (0 if none apply). */
+    static int commanderReduction(final Card c, final Card commander) {
+        int n = 0;
+        for (final StaticAbility st : c.getStaticAbilities()) {
+            if (!st.checkMode(StaticAbilityMode.ReduceCost)) {
+                continue;
+            }
+            try {
+                if (st.hasParam("ValidCard") && !commander.isValid(st.getParam("ValidCard").split(","), c.getController() == null ? commander.getController() : c.getController(), c, st)) {
+                    continue;
+                }
+                n += st.hasParam("Amount") ? Math.max(1, AbilityUtils.calculateAmount(c, st.getParam("Amount"), st)) : 1;
+            } catch (RuntimeException e) {
+                n += 1;
+            }
+        }
+        return n;
+    }
+
+    public static boolean pilotWantMulligan(final Player ai, final int cardsToReturn) {
+        final CardCollectionView hand = ai.getCardsIn(ZoneType.Hand);
+        if (hand.isEmpty()) {
+            return false;
+        }
+        final int finalSize = hand.size() - cardsToReturn;
+        int lands = 0, ramp = 0, reduce = 0;
+        Card commander = null;
+        for (final Card c : ai.getCardsIn(ZoneType.Command)) {
+            if (c.isCommander() && ai.equals(c.getOwner())) {
+                commander = c;
+                break;
+            }
+        }
+        for (final Card c : hand) {
+            if (c.isLand()) {
+                lands++;
+            }
+        }
+        for (final Card c : hand) {
+            if (c.isLand()) {
+                continue;
+            }
+            final SpellAbility sp = c.getFirstSpellAbility();
+            if (sp == null || !isRamp(ai, sp) || c.getCMC() > Math.max(1, Math.min(3, lands))) {
+                continue;   // only ramp the hand's lands can cast by turn 3
+            }
+            ramp += rampMana(c);
+            if (commander != null) {
+                reduce += commanderReduction(c, commander);
+            }
+        }
+        final boolean floor = lands >= 3 || lands == 2 && ramp >= 2;
+        final boolean flood = lands >= 6;
+        boolean mull;
+        String why;
+        int projected = -1;
+        if (finalSize <= 5) {
+            mull = lands < 2;
+            why = "5 or fewer cards: keep with 2+ lands";
+        } else if (!floor || flood) {
+            mull = true;
+            why = flood ? "flood" : "below the floor";
+        } else if (finalSize == 6 || commander == null || commander.getCMC() < 4) {
+            mull = false;
+            why = "floor met";
+        } else {
+            final int cost = Math.max(0, commander.getCMC() - reduce);
+            final CardCollectionView lib = ai.getCardsIn(ZoneType.Library);
+            final double share = lib.isEmpty() ? 0 : (double) CardLists.count(lib, CardPredicates.LANDS) / lib.size();
+            projected = 99;
+            for (int t = 1; t <= 12; t++) {
+                final double mana = Math.min(t, lands + (t - 1) * share) + ramp;
+                if (mana + 0.5 >= cost) {
+                    projected = t;
+                    break;
+                }
+            }
+            final int target = commander.getCMC() <= 4 ? 4 : 5;
+            mull = projected > target + 1;
+            why = "commander " + commander.getName() + " (cost " + commander.getCMC() + ", -" + reduce + ") projected on turn " + projected + ", target " + target;
+        }
+        System.out.println("#FP-MULL {\"player\": \"" + ai.getName() + "\", \"cards\": " + finalSize + ", \"lands\": " + lands + ", \"ramp\": " + ramp
+                + ", \"reduce\": " + reduce + ", \"mulligan\": " + mull + ", \"why\": \"" + why.replace("\"", "'") + "\"}");
+        return mull;
+    }
+
+    /** London mulligan: keep lands up to 4 (worst extras go first), keep ramp, bottom the most expensive other cards. */
+    public static CardCollectionView pilotCardsToBottom(final Player ai, final CardCollectionView hand, final int cardsToReturn) {
+        final List<Card> order = new ArrayList<>(hand);
+        final int lands = CardLists.count(hand, CardPredicates.LANDS);
+        final java.util.function.ToIntFunction<Card> keep = c -> {
+            if (c.isLand()) {
+                return lands > 4 ? 100 : 1000;                  // extra lands beyond 4 are bottom candidates
+            }
+            final SpellAbility sp = c.getFirstSpellAbility();
+            if (sp != null && isRamp(ai, sp)) {
+                return 500 - c.getCMC();
+            }
+            return 300 - 10 * c.getCMC();
+        };
+        order.sort(Comparator.comparingInt(keep));
+        final CardCollection out = new CardCollection();
+        for (int i = 0; i < Math.min(cardsToReturn, order.size()); i++) {
+            out.add(order.get(i));
+        }
+        return out;
+    }
