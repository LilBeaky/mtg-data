+        // (it sees City sacrificed), which stranded lands in hand for whole games
+        if (sa.isLandAbility() && forge.ai.ability.DrawAi.pilotSeat(player)) {
+            final Boolean worth = landDropWorthSacrifice(card);
+            if (worth != null) {
+                return worth ? AiPlayDecision.WillPlay : AiPlayDecision.AnotherTime;
+            }
+        }
