+    /** fishpond patch 14: null when nothing of ours is sacrificed by a land drop; otherwise whether this land is worth it:
+     *  the hand is over its limit (a card goes at cleanup anyway), the land does something besides mana (fetch, utility,
+     *  enters-the-battlefield trigger), we have landfall payoffs, or it's a fresh City replacing tapped ones. */
+    private Boolean landDropWorthSacrifice(final Card land) {
+        final CardCollection sacOnLand = CardLists.filter(player.getCardsIn(ZoneType.Battlefield), AiController::sacrificedOnLandDrop);
+        if (sacOnLand.isEmpty()) {
+            return null;
+        }
+        if (sacrificedOnLandDrop(land)) {
+            return sacOnLand.allMatch(Card::isTapped);
+        }
+        if (land.isInZone(ZoneType.Hand) && player.getCardsIn(ZoneType.Hand).size() > player.getMaxHandSize()) {
+            return true;
+        }
+        if (!land.getTriggers().isEmpty()
+                || land.getSpellAbilities().anyMatch(a -> a.isActivatedAbility() && !a.isManaAbility() && !a.isLandAbility())) {
+            return true;
+        }
+        for (final Card c : player.getCardsIn(ZoneType.Battlefield)) {
+            for (final Trigger t : c.getTriggers()) {
+                if (t.getMode() == TriggerType.ChangesZone && "Battlefield".equals(t.getParam("Destination"))
+                        && t.getParamOrDefault("ValidCard", "").contains("Land") && !t.getParam("ValidCard").contains("nonLand")) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private static boolean sacrificedOnLandDrop(final Card c) {
+        for (final Trigger t : c.getTriggers()) {
+            if (t.getMode() == TriggerType.LandPlayed && t.ensureAbility() != null
+                    && t.ensureAbility().getApi() == ApiType.Sacrifice && !t.ensureAbility().hasParam("Defined")) {
+                return true;
+            }
+        }
+        return false;
+    }
+
