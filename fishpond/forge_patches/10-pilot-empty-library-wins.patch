      */
+    // ---- Fishpond patch 10: a self-decking draw is fine when it wins this turn. Forge's AI allowed one only with
+    // Laboratory Maniac out (now ComputerUtil.winsOnEmptyLibraryDraw, any such effect); this also covers drawing the
+    // library out to then cast an ETB win card (Enter the Infinite into Thassa's Oracle) or to attack with a creature that
+    // wins with a full hand (Twenty-Toed Toad). Only for the pilot seats.
+    public static boolean selfDeckWins(final Player ai, final SpellAbility sa) {
+        if (!pilotSeat(ai) || ai.cantWin() || sa.usesTargeting() || sa.hasParam("Defined") && !"You".equals(sa.getParam("Defined"))) {
+            return false;
+        }
+        final Card source = sa.getHostCard();
+        final int lib = ai.getCardsIn(ZoneType.Library).size();
+        final int numCards = sa.hasParam("NumCards") ? AbilityUtils.calculateAmount(source, sa.getParam("NumCards"), sa) : 1;
+        if (numCards < lib - 3) {
+            return false;                                  // not a self-decking draw: the normal rules apply
+        }
+        if (ComputerUtil.winsOnEmptyLibraryDraw(ai)) {
+            return true;
+        }
+        int back = 0;                                      // cards then put from hand onto the library (Enter the Infinite)
+        for (SpellAbility sub = sa.getSubAbility(); sub != null; sub = sub.getSubAbility()) {
+            if (sub.getApi() == ApiType.ChangeZone && "Hand".equals(sub.getParam("Origin")) && "Library".equals(sub.getParam("Destination"))) {
+                back += sub.hasParam("ChangeNum") ? AbilityUtils.calculateAmount(source, sub.getParam("ChangeNum"), sub) : 1;
+            }
+        }
+        final int drawn = Math.min(numCards, lib);
+        final int libAfter = lib - drawn + back;
+        int handAfter = ai.getCardsIn(ZoneType.Hand).size() + drawn - back;
+        if (sa.isSpell() && source.isInZone(ZoneType.Hand)) {
+            handAfter--;
+        }
+        final PhaseHandler ph = ai.getGame().getPhaseHandler();
+        // a creature that wins when it attacks with a full hand, able to attack this turn
+        if (ph.isPlayerTurn(ai) && ph.getPhase() != null && ph.getPhase().isBefore(PhaseType.COMBAT_DECLARE_ATTACKERS) && handAfter >= 20) {
+            for (final Card c : ai.getCreaturesInPlay()) {
+                if (hasWinTrigger(c, TriggerType.Attacks) && forge.game.combat.CombatUtil.canAttack(c)) {
+                    return true;
+                }
+            }
+        }
+        // a card in hand that wins when it enters with the library this small, castable after this one
+        if (libAfter <= 1) {
+            final int cost = castFree(ai, source) || sa.getPayCosts() == null ? 0 : sa.getPayCosts().getTotalMana().getCMC();
+            final int manaLeft = ComputerUtilMana.getAvailableManaEstimate(ai, false) - cost;
+            for (final Card c : ai.getCardsIn(ZoneType.Hand)) {
+                if (c != source && hasWinTrigger(c, TriggerType.ChangesZone) && (castFree(ai, c) || c.getManaCost().getCMC() <= manaLeft)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private static boolean castFree(final Player ai, final Card c) {
+        for (final forge.game.card.CardPlayOption o : c.mayPlay(ai)) {
+            if (o.getPayManaCost() == forge.game.card.CardPlayOption.PayManaCost.NO) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** A trigger of this mode (for ChangesZone: entering the battlefield) whose ability can win the game. */
+    private static boolean hasWinTrigger(final Card c, final TriggerType mode) {
+        for (final Trigger t : c.getTriggers()) {
+            if (t.getMode() != mode || mode == TriggerType.ChangesZone && !"Battlefield".equals(t.getParam("Destination"))) {
+                continue;
+            }
+            for (SpellAbility a = t.ensureAbility(); a != null; a = a.getSubAbility()) {
+                if (a.getApi() == ApiType.WinsGame) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
