+    /**
+     * Whether p has an effect that makes it win instead of drawing from an empty library (Laboratory Maniac, Jace, Wielder
+     * of Mysteries, ...). Read from the replacement effects on p's battlefield, not a card name (fishpond patch 10).
+     */
+    public static boolean winsOnEmptyLibraryDraw(final Player p) {
+        if (p == null || p.cantWin()) {
+            return false;
+        }
+        for (final Card c : p.getCardsIn(ZoneType.Battlefield)) {
+            for (final ReplacementEffect re : c.getReplacementEffects()) {
+                if (re.getMode() != ReplacementType.Draw || !re.hasParam("ReplaceWith")) {
+                    continue;
+                }
+                final SpellAbility rsa = re.ensureAbility();
+                if (rsa != null && rsa.getApi() == ApiType.WinsGame) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
