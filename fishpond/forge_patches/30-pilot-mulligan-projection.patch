+    /** fishpond patch 30 (D9): the commander's cost shrinks with the board (affinity, convoke, improvise, delve, or a
+     *  ReduceCost static on itself), so a lands-based projection of its turn means nothing. */
+    static boolean pilotSelfDiscounting(final Card commander) {
+        if (commander.hasKeyword(Keyword.AFFINITY) || commander.hasKeyword(Keyword.CONVOKE) || commander.hasKeyword(Keyword.IMPROVISE)
+                || commander.hasKeyword(Keyword.DELVE)) {
+            return true;
+        }
+        for (final StaticAbility st : commander.getStaticAbilities()) {
+            if (st.checkMode(StaticAbilityMode.ReduceCost) && st.getParamOrDefault("ValidCard", "").startsWith("Card.Self")) {
+                return true;
+            }
+        }
+        return false;
+    }
