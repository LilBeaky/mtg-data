+    /** Does the player control a permanent that triggers when a card is cycled? */
+    static boolean hasCyclingPayoff(Player ai) {
+        for (Card c : ai.getCardsIn(ZoneType.Battlefield)) {
+            for (Trigger t : c.getTriggers()) {
+                if (t.getMode() == TriggerType.Cycled) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    static int cyclersInHand(Player ai) {
+        int n = 0;
+        for (Card c : ai.getCardsIn(ZoneType.Hand)) {
+            for (SpellAbility s : c.getSpellAbilities()) {
+                if (s.isCycling()) { n++; break; }
+            }
+        }
+        return n;
+    }
+
+    /** When cycling is worth it with a payoff out: during an opponent's combat once attackers are declared (a flicker or
+     *  damage payoff answers an attacker), at the end of the turn before the AI's own or in its own main 2 while it holds a
+     *  spare cycler (one is kept for the next combat), or any time its life is in danger. */
+    static boolean cyclingWindow(Player ai, PhaseHandler ph) {
+        if (ComputerUtil.aiLifeInDanger(ai, false, 0)) {
+            return true;
+        }
+        if (!ph.isPlayerTurn(ai)) {
+            if ((ph.is(PhaseType.COMBAT_DECLARE_ATTACKERS) || ph.is(PhaseType.COMBAT_DECLARE_BLOCKERS))
+                    && ph.getCombat() != null && !ph.getCombat().getAttackersOf(ai).isEmpty()) {
+                return true;
+            }
+            return ph.getNextTurn().equals(ai) && ph.is(PhaseType.END_OF_TURN) && cyclersInHand(ai) >= 2;
+        }
+        return ph.is(PhaseType.MAIN2) && cyclersInHand(ai) >= 2;   // keep one for the opponents' combats
+    }
