+    /**
+     * fishpond patch 19: an amount read from the card the cost sacrifices ("Sacrificed$CardPower": Jarad, Golgari Lich Lord)
+     * is 0 before anything is sacrificed, so Forge's AI never activated it. Estimate it from the card the AI would pay with;
+     * when a sacrificeable creature makes the loss lethal to an opponent, plan that one instead (the payment reads
+     * ComputerUtil.PLANNED_SAC).
+     */
+    private static int sacrificedAmount(final Player ai, final SpellAbility sa, final String amountStr) {
+        final Card source = sa.getHostCard();
+        final String svar = source.getSVar(amountStr);
+        if (sa.getPayCosts() == null || !svar.startsWith("Sacrificed$")) {
+            return 0;
+        }
+        for (final forge.game.cost.CostPart part : sa.getPayCosts().getCostParts()) {
+            if (!(part instanceof forge.game.cost.CostSacrifice sac) || sac.payCostFromSource()) {
+                continue;
+            }
+            final forge.game.card.CardCollection list = forge.game.card.CardLists.filter(
+                    forge.game.card.CardLists.getValidCards(ai.getCardsIn(ZoneType.Battlefield), sac.getType().split(";"), ai, source, sa),
+                    forge.game.card.CardPredicates.canBeSacrificedBy(sa, false));
+            list.remove(source);
+            final java.util.function.ToIntFunction<Card> value = c -> svar.contains("CardToughness") ? c.getNetToughness()
+                    : svar.contains("CardManaCost") ? c.getCMC() : c.getNetPower();
+            int minOppLife = Integer.MAX_VALUE;
+            for (final Player o : ai.getOpponents()) {
+                if (o.canLoseLife()) {
+                    minOppLife = Math.min(minOppLife, o.getLife());
+                }
+            }
+            Card lethal = null;
+            for (final Card c : list) {
+                if (!c.isCommander() && value.applyAsInt(c) >= minOppLife
+                        && (lethal == null || ComputerUtilCard.evaluateCreature(c) < ComputerUtilCard.evaluateCreature(lethal))) {
+                    lethal = c;
+                }
+            }
+            if (lethal != null) {
+                ComputerUtil.PLANNED_SAC.put(sa, lethal);
+                return value.applyAsInt(lethal);
+            }
+            ComputerUtil.PLANNED_SAC.remove(sa);
+            final Card fodder = ComputerUtil.pilotSacFodder(ai, list, sa);
+            return fodder == null ? 0 : value.applyAsInt(fodder);
+        }
+        return 0;
+    }
