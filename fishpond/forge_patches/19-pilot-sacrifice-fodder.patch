+    // ---- fishpond patch 19: sacrifice fodder for pilot seats ----
+    public static final Map<SpellAbility, Card> PLANNED_SAC = Collections.synchronizedMap(new WeakHashMap<>());
+
+    /**
+     * The cheapest thing to sacrifice from typeList, or null: tokens first (noncreature ones such as Food, Treasure and Clue
+     * before creature tokens), then nonland permanents of mana value 3 or less (ones without a mana ability first), then
+     * creatures Forge rates low (evaluateCreature <= 135). Never the commander, a deck's key card or the ability's own
+     * source. Lands are left to Forge's land rule.
+     */
+    public static Card pilotSacFodder(final Player ai, final CardCollectionView typeList, final SpellAbility sa) {
+        final List<String> keys = ai.getRegisteredPlayer() == null || ai.getRegisteredPlayer().getDeck() == null
+                ? Collections.emptyList() : ai.getRegisteredPlayer().getDeck().getKeyCards();
+        final Card host = sa == null ? null : sa.getHostCard();
+        Card best = null;
+        int bestScore = Integer.MAX_VALUE;
+        for (final Card c : typeList) {
+            if (c == host || c.isCommander() || c.isLand() || keys.contains(c.getName())) {
+                continue;
+            }
+            int score;
+            if (c.isToken()) {
+                score = c.isCreature() ? 50 + ComputerUtilCard.evaluateCreature(c) / 10 : c.getCMC();
+            } else if (c.isCreature()) {
+                final int eval = ComputerUtilCard.evaluateCreature(c);
+                if (eval > 135) {
+                    continue;
+                }
+                score = 200 + eval;
+            } else {
+                if (c.getCMC() > 3) {
+                    continue;
+                }
+                score = 100 + 10 * c.getCMC() + (c.getManaAbilities().isEmpty() ? 0 : 40);
+            }
+            if (score < bestScore) {
+                bestScore = score;
+                best = c;
+            }
+        }
+        return best;
+    }
+
+    /** Fodder worth giving up for a repeatable effect: a token, a SacMe card, a cheap noncreature permanent with no mana
+     *  ability, a low-rated creature, or a mana rock once its controller has 6 lands. */
+    public static boolean pilotCheapFodder(final Player ai, final Card c) {
+        if (c == null) {
+            return false;
+        }
+        if (c.isToken() || c.hasSVar("SacMe")) {
+            return true;
+        }
+        if (!c.getManaAbilities().isEmpty()) {
+            return !c.isCreature() && ai.getLandsInPlay().size() >= 6;
+        }
+        return c.isCreature() ? ComputerUtilCard.evaluateCreature(c) <= 135 : c.getCMC() <= 3;
+    }
+
+    /**
+     * fishpond patch 19: Forge plays a damage or life-loss ability with a sacrifice cost only when it is nearly lethal
+     * ("urgent"), because a sacrifice is not a reusable cost, so engines like Ragost's (sacrifice a Food: 3 damage to each
+     * opponent) and Jarad's (sacrifice a creature: each opponent loses its power) sat idle. For a pilot seat such an ability
+     * is fine whenever the card it would sacrifice is cheap fodder, at Forge's timing for reusable abilities: the AI's own
+     * second main phase, or the end of the turn before its own.
+     */
+    public static boolean pilotCheapSacrificeNow(final Player ai, final SpellAbility sa) {
+        if (!forge.ai.ability.DrawAi.pilotSeat(ai) || sa.getPayCosts() == null) {
+            return false;
+        }
+        final PhaseHandler ph = ai.getGame().getPhaseHandler();
+        final boolean timing = ph.is(PhaseType.MAIN2, ai) || ph.is(PhaseType.END_OF_TURN) && ph.getNextTurn().equals(ai);
+        if (!timing) {
+            return false;
+        }
+        boolean sacrifice = false;
+        for (final forge.game.cost.CostPart part : sa.getPayCosts().getCostParts()) {
+            if (part instanceof forge.game.cost.CostSacrifice sac) {
+                if (sac.payCostFromSource() || !"1".equals(sac.getAmount())) {
+                    return false;
+                }
+                final CardCollection list = CardLists.filter(CardLists.getValidCards(ai.getCardsIn(ZoneType.Battlefield),
+                        sac.getType().split(";"), ai, sa.getHostCard(), sa), CardPredicates.canBeSacrificedBy(sa, false));
+                list.remove(sa.getHostCard());
+                final Card planned = PLANNED_SAC.get(sa);
+                final Card fodder = planned != null && list.contains(planned) ? planned : getCardPreference(ai, sa.getHostCard(), "SacCost", list, sa);
+                if (!pilotCheapFodder(ai, fodder)) {
+                    return false;
+                }
+                sacrifice = true;
+            } else if (!(part instanceof forge.game.cost.CostPartMana) && !(part instanceof forge.game.cost.CostTap)) {
+                return false;
+            }
+        }
+        return sacrifice;
+    }
