+++ b/forge-ai/src/main/java/forge/ai/AiBlockController.java
@@ -976,6 +976,47 @@ public class AiBlockController {
         }
     }
 
+    /**
+     * Fishpond patch 11: on a huge board (token swarms: Scute Swarm, Field of the Dead) every pass of the block planner
+     * costs attackers x blockers expensive checks, and the AI predicts blocks many times per decision (which opponent to
+     * attack, is my life in danger, the lookahead's combat preview), so one turn could take half an hour. Past
+     * -Dfishpond.maxBlockPairs (default 400, e.g. 20 x 20; 0 turns it off) plan blocks only for the biggest attackers with
+     * the best blockers: the other attackers count as unblocked (a cautious estimate of the damage) and the other
+     * blockers stay back. Boards under the limit are planned exactly as before.
+     */
+    private void limitBoardSize() {
+        final int limit = Integer.getInteger("fishpond.maxBlockPairs", 400);
+        final int a = attackersLeft.size(), b = blockersLeft.size();
+        if (limit <= 0 || (long) a * b <= limit) {
+            return;
+        }
+        final int side = Math.max(1, (int) Math.sqrt(limit));
+        int keepA, keepB;
+        if (a >= b) {
+            keepB = Math.min(b, side);
+            keepA = Math.min(a, Math.max(1, limit / keepB));
+        } else {
+            keepA = Math.min(a, side);
+            keepB = Math.min(b, Math.max(1, limit / keepA));
+        }
+        if (keepA < a) {
+            final Map<Card, Integer> dmg = new HashMap<>();
+            for (final Card c : attackersLeft) {
+                dmg.put(c, ComputerUtilCombat.damageIfUnblocked(c, ai, null, false));
+            }
+            attackersLeft.sort((x, y) -> Integer.compare(dmg.get(y), dmg.get(x)));
+            attackersLeft = new ArrayList<>(attackersLeft.subList(0, keepA));
+        }
+        if (keepB < b) {
+            final Map<Card, Integer> val = new HashMap<>();
+            for (final Card c : blockersLeft) {
+                val.put(c, ComputerUtilCard.evaluateCreature(c));
+            }
+            blockersLeft.sort((x, y) -> Integer.compare(val.get(y), val.get(x)));
+            blockersLeft = new ArrayList<>(blockersLeft.subList(0, keepB));
+        }
+    }
+
