+    // ---- fishpond patch 23: life budget ----
+    // The AI paid life into boards that killed it: Niv 22 -> 12 through Bolas's Citadel and Vampiric Tutor, then died to
+    // 19; Erebos paid Vilis 13 times (24 -> 4); Erebos paid 8 for draws and died to exactly 20 (FORGE_PLAN item 2).
+    // Forge only kept a fixed floor (4 life for most abilities). A pilot seat now refuses a play whose life cost (life
+    // paid as a cost, plus "you lose N life" in its own effect) leaves it dead to the next combat the table can make:
+    // budget = life minus the biggest attack before its next turn (ComputerUtil.aiLifeInDanger, serious).
+    static int lifeCostOf(final Player ai, final SpellAbility sa) {
+        int n = 0;
+        if (sa.getPayCosts() != null) {
+            for (final forge.game.cost.CostPart part : sa.getPayCosts().getCostParts()) {
+                if (part instanceof forge.game.cost.CostPayLife payLife) {
+                    n += payLife.getAbilityAmount(sa);
+                }
+            }
+        }
+        for (SpellAbility a = sa; a != null; a = a.getSubAbility()) {
+            if (a.getApi() == ApiType.LoseLife && "You".equals(a.getParamOrDefault("Defined", "You"))) {
+                try {
+                    n += AbilityUtils.calculateAmount(a.getHostCard(), a.getParamOrDefault("LifeAmount", "0"), a);
+                } catch (RuntimeException e) {
+                    // amount not known before resolving: ignore
+                }
+            }
+        }
+        return n;
+    }
