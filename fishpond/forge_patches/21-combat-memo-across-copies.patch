     // player's life and poison, the turn and phase, and the arguments. On huge boards this was most of the run time.
     private static final Map<Game, Map<String, Integer>> COMBAT_MEMO = Collections.synchronizedMap(new WeakHashMap<>());
 
+    // fishpond patch 21: hybrid's one-move check scores every candidate play on a fresh copy of the game (GameCopier), so a
+    // memo per Game never hit there: the unchanged board was re-planned once per candidate, and so was every "after" board
+    // that changes no creature (a land, a mana rock). Copies record the game they were copied from (GameCopier, patch
+    // 21), and the memo is shared by a game and all its copies; the key (below) is what makes two boards the same.
+    // -Dfishpond.memoAcrossCopies=false restores the per-Game memo; -Dfishpond.memoStats=true prints #FP-MEMO per turn.
+    public static final Map<Game, Game> MEMO_ROOT = Collections.synchronizedMap(new WeakHashMap<>());
+    private static final boolean MEMO_ACROSS_COPIES = !"false".equals(System.getProperty("fishpond.memoAcrossCopies"));
+    private static final boolean MEMO_STATS = Boolean.getBoolean("fishpond.memoStats");
+
+    public static Game memoRoot(final Game g) {
+        final Game r = MEMO_ROOT.get(g);
+        return r == null ? g : r;
+    }
+
+    private static final class MemoStats {
+        int turn = -1;
+        long calls, hits, computes, computeNanos, repeats, repeatNanos;
+        final Set<String> seen = Collections.newSetFromMap(new LinkedHashMap<String, Boolean>(256, 0.75f, true) {
+            @Override
+            protected boolean removeEldestEntry(final Map.Entry<String, Boolean> e) {
+                return size() > 4096;
+            }
+        });
+    }
+
+    private static final Map<Game, MemoStats> MEMO_STATS_BY_ROOT = Collections.synchronizedMap(new WeakHashMap<>());
+
+    private static MemoStats memoStats(final Game root) {
+        final MemoStats st = MEMO_STATS_BY_ROOT.computeIfAbsent(root, k -> new MemoStats());
+        final int turn = root.getPhaseHandler().getTurn();
+        if (st.turn != turn) {
+            if (st.calls > 0) {
+                System.out.println("#FP-MEMO {\"turn\": " + st.turn + ", \"across_copies\": " + MEMO_ACROSS_COPIES + ", \"calls\": " + st.calls
+                        + ", \"hits\": " + st.hits + ", \"computes\": " + st.computes + ", \"compute_ms\": " + st.computeNanos / 1000000
+                        + ", \"repeat_computes\": " + st.repeats + ", \"repeat_ms\": " + st.repeatNanos / 1000000 + "}");
+            }
+            st.turn = turn;
+            st.calls = st.hits = st.computes = st.computeNanos = st.repeats = st.repeatNanos = 0;
+            st.seen.clear();
+        }
+        return st;
+    }
+
+    // keywords that change who can attack, block or survive a combat
+    private static final Keyword[] COMBAT_KEYWORDS = {Keyword.FLYING, Keyword.REACH, Keyword.FIRST_STRIKE, Keyword.DOUBLE_STRIKE,
+            Keyword.DEATHTOUCH, Keyword.TRAMPLE, Keyword.VIGILANCE, Keyword.HASTE, Keyword.MENACE, Keyword.INDESTRUCTIBLE,
+            Keyword.LIFELINK, Keyword.DEFENDER, Keyword.SHADOW, Keyword.HORSEMANSHIP, Keyword.INFECT, Keyword.WITHER,
+            Keyword.FEAR, Keyword.INTIMIDATE, Keyword.SKULK, Keyword.HEXPROOF, Keyword.SHROUD, Keyword.PROTECTION};
+
     public static int predictNextCombatsRemainingLife(Player ai, boolean serious, boolean checkDiff, int payment, final CardCollection excludedBlockers, final List<Player> opps) {
         final Game g = ai.getGame();
