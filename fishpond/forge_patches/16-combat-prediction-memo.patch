+            key.append(p.getId()).append(',');
+        }
+        for (final Player p : g.getPlayers()) {
+            key.append('|').append(p.getId()).append(':').append(p.getLife()).append(':').append(p.getPoisonCounters());
+        }
+        for (final Card c : g.getCardsIn(ZoneType.Battlefield)) {
+            if (c.isCreature() || c.isPlaneswalker()) {
+                key.append(';').append(c.getId()).append(c.getController().getId()).append(c.isTapped() ? 't' : 'u')
+                        .append(c.isSick() ? 's' : 'r').append(c.getNetPower()).append('/').append(c.getNetToughness());
+            }
+        }
+        final Map<String, Integer> memo = COMBAT_MEMO.computeIfAbsent(g, k -> new LinkedHashMap<String, Integer>(64, 0.75f, true) {
+            @Override
+            protected boolean removeEldestEntry(final Map.Entry<String, Integer> e) {
+                return size() > 256;
+            }
+        });
+        final String k = key.toString();
+        synchronized (memo) {
+            final Integer hit = memo.get(k);
+            if (hit != null) {
+                return hit;
+            }
+        }
+        final int result = predictNextCombatsRemainingLife0(ai, serious, checkDiff, payment, excludedBlockers, opps);
+        synchronized (memo) {
+            memo.put(k, result);
+        }
+        return result;
+    }
