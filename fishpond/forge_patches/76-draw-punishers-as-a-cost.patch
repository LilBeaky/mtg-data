     /** A card that wins when it enters with a tiny library (Thassa's Oracle) or wins on an empty-library draw while it is
      *  on the battlefield (Laboratory Maniac, Jace, Wielder of Mysteries). Fishpond patch 17. */
+    // ---- fishpond patch 76: draw punishers (the user, 2026-10-18: "make it math out the damage and treat it as a cost ... just make it
+    // aware"). Klauth's Knollspine Dragon drew 14 with Xyris's Razorkin Needlehead out and lost 14 life without the AI weighing it.
+    // Opponents' permanents with a trigger on an opponent's draw that deals damage to or takes life from the drawer (Razorkin
+    // Needlehead, Nekusar, Sheoldred, Underworld Dreams, Scrawling Crawler; Orcish Bowmasters counted as hitting the drawer).
+
+    /** Life drawer would lose to its opponents' draw punishers for drawing n cards now. */
+    public static int drawPunishment(final Player drawer, final int n) {
+        if (n <= 0) {
+            return 0;
+        }
+        final boolean drawStep = drawer.getGame().getPhaseHandler().is(PhaseType.DRAW, drawer);
+        int total = 0;
+        for (final Player o : drawer.getOpponents()) {
+            if (o.hasLost()) {
+                continue;
+            }
+            for (final Card c : o.getCardsIn(ZoneType.Battlefield)) {
+                for (final Trigger t : c.getTriggers()) {
+                    if (t.getMode() != TriggerType.Drawn || !t.getParamOrDefault("ValidCard", "").contains("Opp")) {
+                        continue;
+                    }
+                    SpellAbility ex;
+                    try {
+                        ex = t.ensureAbility();
+                    } catch (final RuntimeException e) {
+                        continue;
+                    }
+                    int per = 0;
+                    for (SpellAbility x = ex; x != null; x = x.getSubAbility()) {
+                        if (x.getApi() == ApiType.DealDamage) {
+                            per += fixedAmount(x, "NumDmg");
+                        } else if (x.getApi() == ApiType.LoseLife) {
+                            per += fixedAmount(x, "LifeAmount");
+                        }
+                    }
+                    final int count = "False".equals(t.getParam("FirstCardInDrawStep")) && drawStep ? n - 1 : n;
+                    total += per * Math.max(0, count);
+                }
+            }
+        }
+        return total;
+    }
+
+    private static int fixedAmount(final SpellAbility x, final String param) {
+        try {
+            return Integer.parseInt(x.getParamOrDefault(param, "1"));
+        } catch (final NumberFormatException e) {
+            return 1;
+        }
+    }
+
+    /** The punishers' life cost of the cards sa makes ai draw (its Draw effects that include ai). */
+    public static int drawLifeCost(final Player ai, final SpellAbility sa) {
+        int n = 0;
+        for (SpellAbility x = sa; x != null; x = x.getSubAbility()) {
+            if (x.getApi() != ApiType.Draw) {
+                continue;
+            }
+            final String def = x.getParamOrDefault("Defined", "You");
+            if (!def.equals("You") && !def.equals("Player")) {
+                continue;
+            }
+            try {
+                n += Math.max(0, AbilityUtils.calculateAmount(x.getHostCard(), x.getParamOrDefault("NumCards", "1"), x));
+            } catch (final RuntimeException e) {
+                n += 1;
+            }
+        }
+        return drawPunishment(ai, n);
+    }
+
+    /** Whether ai accepts the punishers' cost as it would a "pay that much life" cost (Forge's own life-payment check). */
+    public static boolean drawCostOk(final Player ai, final SpellAbility sa) {
+        final int cost = drawLifeCost(ai, sa);
+        return cost <= 0 || ComputerUtilCost.checkLifeCost(ai, new Cost("PayLife<" + cost + ">", false), sa.getHostCard(), 4, sa);
+    }
