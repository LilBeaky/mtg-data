+        /** patch 114: the seat faces lethal from the next combats (commander damage included) and this wipe takes at least half
+         *  of the attack of the opponent with the biggest one, or leaves no opponent able to kill it unblocked. */
+        static boolean defuses(final Player ai, final java.util.Map<Player, java.util.Set<Card>> hits) {
+            if (!forge.ai.ability.DrawAi.pilotSeat(ai) || !ComputerUtil.aiLifeInDanger(ai, true, 0)) {
+                return false;
+            }
+            Player killer = null;
+            double worstBefore = -1, killerAfter = 0, maxAfter = 0;
+            boolean cmdLethalAfter = false;
+            for (final Player o : ai.getOpponents()) {
+                if (o.hasLost()) continue;
+                final java.util.Set<Card> gone = hits.getOrDefault(o, java.util.Collections.emptySet());
+                double before = 0, after = 0;
+                for (final Card att : o.getCreaturesInPlay()) {
+                    if (!ComputerUtilCombat.canAttackNextTurn(att, ai)) continue;
+                    final int d = ComputerUtilCombat.damageIfUnblocked(att, ai, null, false);
+                    before += d;
+                    if (!gone.contains(att)) {
+                        after += d;
+                        if (att.isCommander() && ai.getCommanderDamage(att) + d >= 21) cmdLethalAfter = true;
+                    }
+                }
+                if (before > worstBefore) { worstBefore = before; killer = o; killerAfter = after; }
+                maxAfter = Math.max(maxAfter, after);
+            }
+            if (killer == null || worstBefore <= 0) return false;
+            return killerAfter <= worstBefore / 2 || (maxAfter < ai.getLife() && !cmdLethalAfter);
+        }
