+    /** {spells the seat may still cast this turn, noncreature spells it may still cast}, -1 for no lock. */
+    static int[] spellsLeft(final Player ai) {
+        final int[] out = {-1, -1};
+        try {
+            final Game g = ai.getGame();
+            for (final Card c : g.getCardsIn(ZoneType.Battlefield)) {
+                for (final forge.game.staticability.StaticAbility st : c.getStaticAbilities()) {
+                    if (!st.checkMode(forge.game.staticability.StaticAbilityMode.CantBeCast) || !st.hasParam("NumLimitEachTurn")
+                            || !st.checkConditions()) continue;
+                    final String caster = st.getParamOrDefault("Caster", "Player");
+                    if (caster.equals("You") && c.getController() != ai || caster.equals("Opponent") && !c.getController().isOpponentOf(ai)) continue;
+                    final String valid = st.getParamOrDefault("ValidCard", "Card");
+                    final int n = Integer.parseInt(st.getParam("NumLimitEachTurn").trim());
+                    if (valid.equals("Card")) {
+                        final int left = Math.max(0, n - ai.getSpellsCastThisTurn());
+                        out[0] = out[0] < 0 ? left : Math.min(out[0], left);
+                    } else if (valid.equals("Card.nonCreature")) {
+                        int cast = 0;
+                        for (final SpellAbility x : g.getStack().getSpellsCastThisTurn()) {
+                            if (x.getActivatingPlayer() == ai && x.getHostCard() != null && !x.getHostCard().isCreature()) cast++;
+                        }
+                        final int left = Math.max(0, n - cast);
+                        out[1] = out[1] < 0 ? left : Math.min(out[1], left);
+                    }
+                }
+            }
+        } catch (final RuntimeException e) { /* no lock we can read */ }
+        return out;
+    }
