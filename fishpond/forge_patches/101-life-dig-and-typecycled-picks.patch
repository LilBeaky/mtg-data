+            if (x.getApi() == ApiType.Shuffle && !x.hasParam("Defined")) return true;
+            if (x.getApi() == ApiType.ChangeZone && x.getParamOrDefault("Origin", "").contains("Library") && x.hasParam("ChangeType")
