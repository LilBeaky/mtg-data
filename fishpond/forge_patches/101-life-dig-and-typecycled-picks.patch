+                && (sa.getHostCard().hasStartOfKeyword("Transmute") && "Hand".equals(sa.getParam("ActivationZone"))
+                    || sa.isCycling() && sa.getApi() == ApiType.ChangeZone && "Library".equals(sa.getParam("Origin")))) {
+            final Plan p = plan(aic, ai);
