+                }
+            }
+        }
+        // patch 85: a tutor the plan valued by its pick is cast as planned (Forge's tutor logic waits for later turns or an end
+        // step); not an X tutor (Forge sizes X in that logic) or one that targets
+        if (TUTOR_VALUE && active(ai) && sa != null && sa.isSpell() && sa.getHostCard() != null && search(sa) != null
