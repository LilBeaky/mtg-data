+    static List<Step> choose(final List<Step> cands, final int room, final List<Restricted> restricted, final List<Integer> units,
+                             final List<Integer> keepPips, final int[] lim) {
+        final int n = cands.size(), k = restricted.size();
+        final boolean[][] pays = new boolean[n][k];
+        for (int i = 0; i < n; i++) for (int j = 0; j < k; j++) pays[i][j] = restricted.get(j).pays(cands.get(i).sa);
+        final int[] left = new int[k];
+        int bestMask = 0;
+        double best = 0;
+        for (int mask = 1; mask < (1 << n); mask++) {
+            int run = 0;
+            double v = 0;
+            boolean ok = true;
+            for (int j = 0; j < k; j++) left[j] = restricted.get(j).amount;
+            // a rock pays back only once cast: the most a set needs at once is checked in cost order, rocks first
+            final List<Integer> set = new ArrayList<>();
+            for (int i = 0; i < n; i++) if ((mask & (1 << i)) != 0) set.add(i);
+            if (lim[0] >= 0 || lim[1] >= 0) {   // patch 95: no more spells than the lock allows
+                int spells = 0, nonCreature = 0;
+                for (final int i : set) {
+                    if (!cands.get(i).sa.isSpell()) continue;
+                    spells++;
+                    if (!cands.get(i).card.isCreature()) nonCreature++;
+                }
+                if (lim[0] >= 0 && spells > lim[0] || lim[1] >= 0 && nonCreature > lim[1]) continue;
+            }
+            set.sort(Comparator.comparingInt((Integer i) -> cands.get(i).effCost - cands.get(i).cost));
+            for (final int i : set) {
+                final Step s = cands.get(i);
+                int need = s.cost;
+                for (int j = 0; j < k && need > 0; j++) {
+                    if (!pays[i][j] || left[j] == 0) continue;
+                    final int u = Math.min(left[j], need);
+                    left[j] -= u;
+                    need -= u;
+                }
+                if (run + need > room) { ok = false; break; }
+                run += need - (s.cost - s.effCost);
+                v += s.net();
+            }
+            if (ok && v > best && units != null) {   // patch 84: the set's colors, and the held answer's, from the sources at once
+                final List<Integer> rest = new ArrayList<>(keepPips), made = new ArrayList<>(), rockPips = new ArrayList<>();
+                for (final int i : set) {
+                    final Step s = cands.get(i);
+                    if (s.units.isEmpty()) rest.addAll(s.pips);
+                    else { rockPips.addAll(s.pips); made.addAll(s.units); }
+                }
+                // a rock or ritual is paid from what's there before it (Dark Ritual's black doesn't pay for Dark Ritual); the
+                // rest from what's left and what they make
+                final List<Integer> spare = spend(rockPips, units);
+                ok = spare != null && fits(rest, concat(spare, made));
+            }
+            if (ok && v > best) {
+                best = v;
+                bestMask = mask;
+            }
+        }
+        final List<Step> out = new ArrayList<>();
+        for (int i = 0; i < n; i++) if ((bestMask & (1 << i)) != 0) out.add(cands.get(i));
+        return out;
+    }
