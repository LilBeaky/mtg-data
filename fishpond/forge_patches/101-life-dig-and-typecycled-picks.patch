+    static int landDrop(final Player ai) {
+        if (ai.getLandsPlayedThisTurn() > 0) {
+            return 0;
+        }
+        for (final Card c : ai.getCardsIn(ZoneType.Hand)) {
+            if (c.isLand() && ai.canPlayLand(c, false, null) && !entersTapped(ai, c)) {
+                return 1;   // patch 75: only a land that comes in untapped (Klauth planned Klauth on Spinerock Knoll's mana)
+            }
+        }
+        return 0;
+    }
