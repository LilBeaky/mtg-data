+    static Step tutor(final AiController aic, final Player ai, final Step s, final int room, final int budget) {
+        if (!TUTOR_VALUE || IN_TUTOR.get()) {
+            return s;
+        }
+        final boolean xCost = s.sa.getPayCosts() != null && s.sa.getPayCosts().hasXInAnyCostPart();
+        SpellAbility x = search(s.sa);
+        final boolean etb = x == null && s.sa.isSpell();
+        if (etb) x = etbSearch(s.card);
+        if (x == null) {
+            return s;
+        }
+        try {
+            x.setActivatingPlayer(ai);
+            final Card host = s.card;
+            final String dest = x.getParam("Destination");
+            final boolean field = "Battlefield".equals(dest), top = "Library".equals(dest);
+            String type = x.getParam("ChangeType");
+            int max = Integer.MAX_VALUE, eq = -1;
+            final boolean le = type.contains("cmcLEX"), eqx = type.contains("cmcEQX");
+            type = type.replaceAll("[.+]cmc(LE|EQ)X", "");
+            if (le || eqx) {
+                int xv;
+                if (xCost) xv = room - s.cost;   // X tutor: what's left after its fixed cost
+                else xv = forge.game.ability.AbilityUtils.calculateAmount(host, "X", x);
+                if (le) max = xv; else eq = xv;
+            }
+            final List<Card> valid = new ArrayList<>();
+            for (final Card l : forge.game.card.CardLists.getValidCards(ai.getCardsIn(ZoneType.Library), type.split(","), ai, host, x)) {
+                if (l.getCMC() <= max && (eq < 0 || l.getCMC() == eq)) valid.add(l);
+            }
+            if (valid.isEmpty()) {
+                return xCost ? null : s;
+            }
+            final ZoneType dz = field ? ZoneType.Battlefield : top ? ZoneType.Library : ZoneType.Hand;
+            final java.util.function.BiFunction<Player, Object[], List<Card>> rk = TUTOR_RANK;
+            List<Card> ranked = rk == null ? null : rk.apply(ai, new Object[] {x, dz, valid});
+            Card pick = ranked == null || ranked.isEmpty() ? null : ranked.get(0);
+            if (pick == null) {
+                pick = forge.ai.ability.ChangeZoneAi.chooseCardToHiddenOriginChangeZone(dz, java.util.List.of(ZoneType.Library), x,
+                        new forge.game.card.CardCollection(valid), ai, ai);
+            }
+            if (pick == null) {
+                return s;
+            }
+            final Card waitingTop = knownTop(ai);
+            if (waitingTop != null && pick.getId() == waitingTop.getId()) {
+                return null;   // patch 89: it's already waiting on top (Personal Tutor, then Mystical Tutor, for the same Approach)
+            }
+            // the pick's own value: the plan's value of casting it now
+            double pv;
+            int pc;
+            IN_TUTOR.set(true);
+            try {
+                SpellAbility ps = pick.isLand() ? null : firstSpell(ai, pick);
+                // patch 101: a pick only ever typecycled (Step Through: its "only when" hint, the user's override) is worth its
+                // cycle at the cycling cost, not a cast it never gets (zurgold2_20261024 game 17: Solve the Equation for Step
+                // Through was planned at 185, the pair "Solve 3 + Step Through 5" never fit, and it sat in hand to turn 12)
+                if (ps != null && !hintAllows(pick, ps)) {
+                    final SpellAbility tc = typecycleAbility(ai, pick);
+                    if (tc != null) ps = tc;
+                }
+                final Step p = ps == null ? null : step(aic, ai, pick, ps);
+                pv = p == null ? base(pick, pick.getCMC()) : p.value;
+                pc = p == null ? 0 : p.cost;
+            } finally {
+                IN_TUTOR.set(false);
+            }
+            int cost;
+            if (field) cost = xCost ? s.cost + pick.getCMC() : s.cost;
+            else if (top) cost = s.cost;
+            else cost = s.cost + pc;
+            // patch 101: a tutor spell's pick to hand that fits next turn's mana (the tutor now, the pick then) is planned as a top tutor's is,
+            // less the turn it waits
+            final boolean nextTurn = s.sa.isSpell() && !field && !top && cost > room && s.cost <= room && pc <= budget + 1;
+            if (!nextTurn && (field ? cost > room : top ? s.cost + pc > budget + 1 : cost > room)) {
+                return xCost ? null : s;   // the pair doesn't fit: the tutor as it was valued before
+            }
+            if (nextTurn) {
+                pv -= CARD_HELD;
+                cost = s.cost;
+            }
+            // patch 101: a tutor spell's key-card pick to hand or the top (typecycling and transmute have their flat bonus; the user, 2026-10-24, on Step Through: "it doesn't seem like we
+            // get Step Through in the first few turns almost ever. It's a big deal when you can")
+            final java.util.function.BiPredicate<Player, Card> kc = AiController.KEY_CARD;
+            try {
+                if (s.sa.isSpell() && !field && kc != null && kc.test(ai, pick)) pv += KEY_PICK;
+            } catch (final RuntimeException e) { /* no key list */ }
+            if (top) {   // patch 89: the draws it waits for (Long-Term Plans puts it third from the top: three draws, and a shuffle undoes it)
+                int pos = 0;
+                try { pos = Integer.parseInt(x.getParamOrDefault("LibraryPosition", "0").trim()); } catch (final NumberFormatException e) { pos = 0; }
+                pv -= CARD_HELD * (1 + Math.max(0, pos));
+            }
+            // a sacrifice it costs (Natural Order): the cheapest creature it could take
+            if (s.sa.getPayCosts() != null && s.sa.getPayCosts().hasSpecificCostType(forge.game.cost.CostSacrifice.class)) {
+                double least = Double.MAX_VALUE;
+                for (final Card k : ai.getCreaturesInPlay()) least = Math.min(least, ComputerUtilCard.evaluateCreature(k));
+                if (least == Double.MAX_VALUE) return null;
+                pv -= least;
+            }
+            double own = base(host, manaCost(s.sa));
+            if (!s.sa.isSpell() && "Library".equals(s.sa.getParam("Origin"))) own += TRANSMUTE;   // patches 73/83's flat tutor bonus
+            final double v = etb ? s.value + pv : s.value - own + pv;
+            final int tier = xCost ? TIER_REST : s.tier;
+            final Step t = new Step(host, s.sa, cost, cost - (s.cost - s.effCost), tier, v);
+            t.pick = pick.getName();
+            return t;
+        } catch (final RuntimeException e) {
+            return xCost ? null : s;
+        }
+    }
