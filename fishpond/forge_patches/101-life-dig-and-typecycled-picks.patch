+    /** A spell that puts cards from the library onto the battlefield over and over while they're permanents (Primal Surge:
+     *  closed 75% of the games it was cast in before the plan, then left out for Chulane and five cheap creatures in
+     *  plan2_20261017): 50 a permanent it should put, the run until the first nonpermanent at the library's mix. 0 if not. */
+    static double libraryCheat(final Player ai, final SpellAbility sa) {
+        if (sa.getApi() != ApiType.Repeat) {
+            return 0;
+        }
+        boolean cheat = false;
+        for (SpellAbility x = sa.getAdditionalAbility("RepeatSubAbility"); x != null && !cheat; x = x.getSubAbility()) {
+            cheat = x.getApi() == ApiType.ChangeZone && "Battlefield".equals(x.getParam("Destination"));
+        }
+        if (!cheat) {
+            return 0;
+        }
+        int perm = 0, other = 0;
+        for (final Card l : ai.getCardsIn(ZoneType.Library)) {
+            if (l.isPermanent()) perm++; else other++;
+        }
+        final double run = other == 0 ? perm : Math.min(perm, (double) perm / other);
+        return 50 * run;
+    }
