+    static boolean isSearch(final SpellAbility x) {
+        if (x.getApi() != ApiType.ChangeZone || !x.getParamOrDefault("Origin", "").contains("Library") || x.hasParam("Defined")
+                || !x.hasParam("ChangeType")) {
+            return false;
+        }
+        final String dest = x.getParamOrDefault("Destination", "");
+        if (!dest.equals("Hand") && !dest.equals("Battlefield") && !dest.equals("Library")) {
+            return false;
+        }
+        for (final String t : x.getParam("ChangeType").split(",")) {
+            if (!t.startsWith("Land") && !t.startsWith("Basic") && !t.startsWith("Plains") && !t.startsWith("Island")
+                    && !t.startsWith("Swamp") && !t.startsWith("Mountain") && !t.startsWith("Forest")) return true;
+        }
+        return false;   // a land search is ramp
+    }
