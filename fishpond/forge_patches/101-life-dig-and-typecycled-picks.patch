+    /** A spell that wins on a later cast and otherwise puts itself into its owner's library (Approach of the Second Sun). */
+    public static boolean selfPlacingWin(final Card c) {
+        for (final SpellAbility sa : c.getSpells()) {
+            boolean win = false, back = false;
+            final List<SpellAbility> parts = new ArrayList<>();
+            for (SpellAbility x = sa; x != null; x = x.getSubAbility()) parts.add(x);
+            for (final String br : new String[] {"TrueSubAbility", "FalseSubAbility"}) {
+                final SpellAbility b = sa.getAdditionalAbility(br);
+                for (SpellAbility x = b; x != null; x = x.getSubAbility()) parts.add(x);
+            }
+            for (final SpellAbility x : parts) {
+                if (x.getApi() == ApiType.WinsGame) win = true;
+                if (x.getApi() == ApiType.ChangeZone && "Stack".equals(x.getParam("Origin")) && "Library".equals(x.getParam("Destination"))) back = true;
+            }
+            if (win && back) return true;
+        }
+        return false;
+    }
