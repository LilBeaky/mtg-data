+    /** fishpond patch 83: the card's own "only when" hint (NeedsToPlay, NeedsToPlayVar) allows casting sa now. */
+    static boolean hintAllows(final Card c, final SpellAbility sa) {
+        if (!c.hasSVar("NeedsToPlayVar") && !c.hasSVar("NeedsToPlay")) {
+            return true;
+        }
+        try {
+            return ComputerUtilCard.checkNeedsToPlayReqs(c, sa) == AiPlayDecision.WillPlay;
+        } catch (final RuntimeException e) {
+            return true;
+        }
+    }
