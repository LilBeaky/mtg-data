+    /** a's static doubles the enter triggers of creature b (Naban, Dean of Iteration and a Wizard with one). */
+    static boolean doubles(final Card a, final Card b) {
+        if (a == b || !b.isCreature()) return false;
+        for (final forge.game.staticability.StaticAbility st : a.getStaticAbilities()) {
+            if (!st.checkMode(forge.game.staticability.StaticAbilityMode.Panharmonicon)) continue;
+            final String type = st.getParamOrDefault("ValidCause", "Card").split("[.+,]")[0];
+            if (!type.equals("Card") && !type.equals("Permanent") && !b.getType().hasStringType(type)) continue;
+            for (final forge.game.trigger.Trigger t : b.getTriggers())
+                if (t.getMode() == forge.game.trigger.TriggerType.ChangesZone && "Battlefield".equals(t.getParam("Destination"))
+                        && t.getParamOrDefault("ValidCard", "").startsWith("Card.Self")) return true;
+        }
+        return false;
+    }
