+    /** Mana it can make now: untapped, usable sources (the harness's usableMana: a choice of colors counts once, mana
+     *  restricted to some spells counts none); Forge's estimate counted tapped sources and each color of a Talisman. */
+    static int manaNow(final Player p) {
+        int total = p.getManaPool().totalMana();
+        boolean free = false;
+        final List<forge.game.trigger.Trigger> extra = new ArrayList<>();
+        for (final Card t : p.getGame().getCardsIn(ZoneType.Battlefield)) {
+            for (final forge.game.trigger.Trigger tr : t.getTriggers()) {
+                if (tr.getMode() == forge.game.trigger.TriggerType.TapsForMana) extra.add(tr);
+            }
+        }
+        for (final Card src : p.getCardsIn(ZoneType.Battlefield)) {
+            int best = 0;
+            for (final SpellAbility ma : src.getManaAbilities()) {
+                try {
+                    ma.setActivatingPlayer(p);
+                    final forge.game.spellability.AbilityManaPart mp = ma.getManaPart();
+                    if (mp == null || !mp.getManaRestrictions().isEmpty() || !ma.canPlay()) continue;
+                    final int cost = ma.getPayCosts().getCostMana() != null ? ma.getPayCosts().getCostMana().convertAmount() : 0;
+                    final String prod = ma.getParamOrDefault("Produced", "");
+                    final int kinds = prod.startsWith("Combo") || prod.isEmpty() ? 1 : prod.split(" ").length;
+                    final int made = kinds * forge.game.ability.AbilityUtils.calculateAmount(src, ma.getParamOrDefault("Amount", "1"), ma) - cost;
+                    if (cost == 0) free = true;
+                    best = Math.max(best, made);
+                } catch (final RuntimeException e) { /* skip an ability whose check throws */ }
+            }
+            if (best > 0) best += tapExtra(src, extra);
+            total += best;
+        }
+        return free ? total : p.getManaPool().totalMana();
+    }
