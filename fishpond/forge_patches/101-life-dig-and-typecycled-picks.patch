+    /** What a rock or a ritual in the plan makes back once cast, as units (its colors: Dark Ritual's three black). */
+    static List<Integer> rockUnits(final Player ai, final Step s) {
+        final int back = s.cost - s.effCost;
+        if (back <= 0) {
+            return List.of();
+        }
+        int mask = 0;
+        if (s.card.isPermanent()) {
+            for (final SpellAbility ma : s.card.getManaAbilities()) {
+                try {
+                    ma.setActivatingPlayer(ai);
+                    if (ma.getManaPart() != null) mask |= colorsOf(ma.getManaPart(), ma);
+                } catch (final RuntimeException e) { /* skip */ }
+            }
+        } else {
+            for (SpellAbility x = s.sa; x != null; x = x.getSubAbility()) {
+                if (x.getApi() != ApiType.Mana) continue;
+                for (final String t : x.getParamOrDefault("Produced", "").split(" ")) {
+                    if (t.equals("Any")) mask |= 31;
+                    for (int i = 0; i < 6; i++) if (t.equals(COLOR_SHORT[i])) mask |= 1 << i;
+                }
+            }
+        }
+        final List<Integer> out = new ArrayList<>();
+        for (int k = 0; k < back; k++) out.add(mask == 0 ? ANY : mask);
+        return out;
+    }
