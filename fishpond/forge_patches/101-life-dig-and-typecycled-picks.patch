+    /** An untapped creature of the seat's has an attack trigger that searches its library (Zur): this combat may shuffle. */
+    static boolean attackSearchReady(final Player ai) {
+        for (final Card c : ai.getCreaturesInPlay()) {
+            if (c.isTapped() || c.isSick()) continue;
+            for (final forge.game.trigger.Trigger t : c.getTriggers()) {
+                if (t.getMode() != forge.game.trigger.TriggerType.Attacks) continue;
+                try {
+                    for (SpellAbility x = t.ensureAbility(); x != null; x = x.getSubAbility())
+                        if (x.getApi() == ApiType.ChangeZone && x.getParamOrDefault("Origin", "").contains("Library") && x.hasParam("ChangeType")) return true;
+                } catch (final RuntimeException e) { /* skip */ }
+            }
+        }
+        return false;
+    }
