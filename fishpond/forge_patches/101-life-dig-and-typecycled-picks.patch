+    static Plan plan(final AiController aic, final Player ai) {
+        final StringBuilder kb = new StringBuilder(phaseKey(ai));
+        for (final Card c : ai.getCardsIn(ZoneType.Hand)) kb.append('|').append(c.getId());
+        for (final Card c : ai.getCardsIn(ZoneType.Command)) kb.append('c').append(c.getId());
+        kb.append('#').append(ai.getCardsIn(ZoneType.Battlefield).size()).append('m').append(manaNow(ai));
+        for (final Restricted r : restrictedMana(ai)) kb.append('r').append(r.amount);
+        final String key = kb.toString();
+        final Object[] c = CACHE.get(ai);
+        if (c != null && key.equals(c[0])) {
+            return (Plan) c[1];
+        }
+        Plan p;
+        try {
+            p = build(aic, ai);
+        } catch (final RuntimeException e) {
+            p = new Plan();
+        }
+        if (cacheGame.get() != ai.getGame()) {
+            CACHE.clear();
+            cacheGame = new java.lang.ref.WeakReference<>(ai.getGame());
+        }
+        CACHE.put(ai, new Object[] {key, p});
+        return p;
+    }
