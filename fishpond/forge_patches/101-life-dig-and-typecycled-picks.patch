+        if (!sa.isSpell() || !c.isPermanent() || c.isInZone(ZoneType.Battlefield)) return false;
+        for (final forge.game.trigger.Trigger t : c.getTriggers()) {
+            if (t.getMode() != forge.game.trigger.TriggerType.Phase || !"Upkeep".equals(t.getParam("Phase"))
+                    || !"Hand".equals(t.getParam("PresentZone"))) continue;
+            final String cmp = t.getParamOrDefault("PresentCompare", "");
+            if (!cmp.startsWith("EQ")) continue;
+            try {
+                boolean wins = false;
+                for (SpellAbility x = t.ensureAbility(); x != null && !wins; x = x.getSubAbility()) wins = x.getApi() == ApiType.WinsGame;
+                if (!wins) continue;
+                final int n = Integer.parseInt(cmp.substring(2).trim());
+                final int hand = ai.getCardsIn(ZoneType.Hand).size() - (c.isInZone(ZoneType.Hand) ? 1 : 0);
+                boolean unlimited = ai.isUnlimitedHandSize() || ai.getMaxHandSize() >= n;
+                for (final forge.game.staticability.StaticAbility st : c.getStaticAbilities())
+                    if ("Unlimited".equals(st.getParam("SetMaxHandSize"))) unlimited = true;
+                if (!unlimited) continue;
+                if (hand == n) return true;
+                if (hand < n && lifeDraw(ai) && ai.getLife() - (n - hand) >= 1) return true;
+            } catch (final RuntimeException e) { /* skip */ }
+        }
+        return false;
+    }
+
+    /** A permanent of the seat's draws X at its end step for X life (Necrodominance). */
+    public static boolean lifeDraw(final Player ai) {
+        for (final Card k : ai.getCardsIn(ZoneType.Battlefield)) {
+            for (final forge.game.trigger.Trigger t : k.getTriggers()) {
+                if (t.getMode() != forge.game.trigger.TriggerType.Phase || !"End of Turn".equals(t.getParam("Phase"))) continue;
+                try {
+                    final SpellAbility x = t.ensureAbility();
+                    if (x != null && x.getApi() == ApiType.Draw && x.getPayCosts() != null
+                            && x.getPayCosts().hasSpecificCostType(forge.game.cost.CostPayLife.class)) return true;
+                } catch (final RuntimeException e) { /* skip */ }
+            }
+        }
+        return false;
+    }
+
+    static Step step(final AiController aic, final Player ai, final Card c, final SpellAbility sa) {
+        // the commander's tax is added at cast time, not in its printed cost; patch 79: the plan pays what it costs now
+        final int printed = manaCost(sa) + (c.isCommander() && c.isInZone(ZoneType.Command) ? 2 * ai.getCommanderCast(c) : 0);
+        final int cost = payCost(ai, sa);
+        double v = base(c, printed);
+        final int prio = aic.castPriorityOf(sa);
+        // a closer the old order put first (a win now, a cheat into something big, a wheel with payoffs) is planned whenever
+        // it fits; a library cheat (Primal Surge) is worth the permanents it would put onto the battlefield
+        final double surge = libraryCheat(ai, sa);
+        final boolean closer = aic.closerNow(sa) || surge > 0 || upkeepWinNear(ai, c, sa) || approachWins(ai, c, sa);
+        // patch 100: a first Approach with the dig to it on the battlefield (Necrodominance) wins next turn
+        if (!closer && sa.isSpell() && selfPlacingWin(c) && !approachArmed(ai) && lifeDraw(ai) && ai.getLife() >= 9) v += CLOSER / 2;
+        if (closer) v += CLOSER + surge;
+        v -= DRAW_LIFE * forge.ai.ability.DrawAi.drawLifeCost(ai, sa);   // patch 76: life lost to the opponents' draw punishers
+        if (!sa.isSpell() && "Hand".equals(sa.getParam("ActivationZone")) && "Library".equals(sa.getParam("Origin"))
+                && c.hasStartOfKeyword("Transmute")) v += TRANSMUTE;   // patch 73: a tutor
+        if (!sa.isSpell() && sa.isCycling() && "Library".equals(sa.getParam("Origin"))) v += TRANSMUTE;   // patch 83: typecycling too
+        // patch 91: with a cycling payoff out (Astral Slide, Drift, Escape Protocol), a cycle also blinks: the loop's Step Through
+        // slides Archaeomancer, which comes back at the end step and returns it
+        if (!sa.isSpell() && sa.isCycling() && forge.ai.ability.DrawAi.hasCyclingPayoffPublic(ai)) v += cycleBlinkValue(ai, c);
+        // patch 91: a lock on damage to the seat (Solitary Confinement) with the table's creatures set to kill it: surviving
+        // first (zur20c_20261023: Zur held Confinement at 16 life into Heliod's 73-damage swing)
+        if (sa.isSpell() && preventsDamageToYou(c)) v += 1300 * lethalDanger(ai);
+        v += prio >= 3 ? 500 : prio == 2 ? 200 : prio == 1 ? 60 : 0;
+        final int pay = aic.payoffUnits(sa);
+        v += 40 * pay;
+        boolean removal = false, wipe = false, info = false;
+        // patch 89: a draw that reaches the card a tutor put on top is worth that card (draw after the tutor)
+        final Card waiting = TUTOR_VALUE && !IN_TUTOR.get() ? knownTop(ai) : null;
+        if (waiting != null && waiting.getId() != c.getId() && drawsYou(sa) > knownTopIndex(ai, waiting)) {
+            IN_TUTOR.set(true);
+            try {
+                final SpellAbility ws = waiting.isLand() ? null : firstSpell(ai, waiting);
+                final Step w = ws == null ? null : step(aic, ai, waiting, ws);
+                v += w == null ? base(waiting, waiting.getCMC()) : w.value;
+            } catch (final RuntimeException e) { /* no bonus */ } finally {
+                IN_TUTOR.set(false);
+            }
+        }
+        for (SpellAbility x = sa; x != null; x = x.getSubAbility()) {
+            if (ComputerUtilCard.Wipe.isWipe(x)) {
+                final double m = ComputerUtilCard.Wipe.margin(ai, x);
+                if (m < 0) {
+                    return null;   // a wipe the table judgement refuses isn't in the plan (Forge may still decide later)
+                }
+                v += m;
+                wipe = true;
+            }
+            final ApiType api = x.getApi();
+            if (api == ApiType.ChangeZone && sa.isSpell() && "Hand".equals(x.getParam("Origin")) && "Battlefield".equals(x.getParam("Destination"))) {
+                // a cheat (Show and Tell, patch 50): worth the best permanent it puts from the caster's hand; one every player
+                // gets (Show and Tell) only for a card worth cheating in (patch 71: cheatWasted)
+                if (symmetricCheat(x) && cheatWasted(ai, sa)) {
+                    return null;
+                }
+                double best = 0;
+                for (final Card h : ai.getCardsIn(ZoneType.Hand)) {
+                    if (h != c && h.isPermanent() && !h.isLand()) best = Math.max(best, base(h, h.getCMC()));
+                }
+                v += best;
+            }
+            if (api == ApiType.Draw || api == ApiType.Dig || api == ApiType.Scry || api == ApiType.Surveil
+                    || (api == ApiType.ChangeZone && "Library".equals(x.getParam("Origin")) && "Hand".equals(x.getParam("Destination")))
+                    || (api == ApiType.ChangeZone && "Library".equals(x.getParam("Origin")) && "Library".equals(x.getParam("Destination")))) {   // patch 89: a top tutor first, draws after
+                info = true;
+            }
+            if (x.usesTargeting() && (api == ApiType.Destroy || api == ApiType.DealDamage || api == ApiType.Sacrifice
+                    || (api == ApiType.ChangeZone && "Battlefield".equals(x.getParam("Origin"))))) {
+                double bestT = -1;
+                for (final Player o : ai.getOpponents()) {
+                    for (final Card t : o.getCardsIn(ZoneType.Battlefield)) {
+                        if (t.isLand()) continue;
+                        try {
+                            if (!x.canTarget(t)) continue;
+                        } catch (final RuntimeException e) {
+                            continue;
+                        }
+                        final double tv = 4 * Math.max(0, AiController.cardThreatOf(ai, t)) + (t.isCreature() ? ComputerUtilCard.evaluateCreature(t) / 2.0 : 40);
+                        bestT = Math.max(bestT, tv);
+                    }
+                }
+                if (bestT < 0) {
+                    return null;   // removal with nothing worth aiming at isn't planned
+                }
+                v += bestT;
+                removal = true;
+            }
+        }
+        if (c.isCommander() && c.isInZone(ZoneType.Command)) {
+            v += 150;
+        }
+        v += commanderDoubler(ai, c);
+        final java.util.function.ToDoubleBiFunction<Player, Card> sv = SETUP_VALUE;
+        final double setup = sv == null ? 0 : Math.max(0, sv.applyAsDouble(ai, c));
+        v += setup;
+        int eff = cost;
+        if (!c.isCreature() && !c.isLand() && c.isArtifact() && !c.getManaAbilities().isEmpty() && !c.hasSVar("ETBTappedSVar")) {
+            int made = 0;
+            for (final SpellAbility ma : c.getManaAbilities()) {
+                try {
+                    final int amount = forge.game.ability.AbilityUtils.calculateAmount(c, ma.getParamOrDefault("Amount", "1"), ma);
+                    final int pc = ma.getPayCosts() != null && ma.getPayCosts().getTotalMana() != null ? ma.getPayCosts().getTotalMana().getCMC() : 0;
+                    made = Math.max(made, amount - pc);
+                } catch (final RuntimeException e) { /* skip */ }
+            }
+            eff = cost - Math.max(0, made);
+        } else if (!c.isPermanent()) {
+            // a ritual pays back what it makes this turn (Dark Ritual: costs 1, makes 3)
+            for (SpellAbility x = sa; x != null; x = x.getSubAbility()) {
+                if (x.getApi() == ApiType.Mana) {
+                    try {
+                        final String prod = x.getParamOrDefault("Produced", "");
+                        final int kinds = prod.startsWith("Combo") || prod.isEmpty() ? 1 : prod.split(" ").length;
+                        eff = cost - kinds * forge.game.ability.AbilityUtils.calculateAmount(c, x.getParamOrDefault("Amount", "1"), x);
+                    } catch (final RuntimeException e) { /* leave the cost */ }
+                }
+            }
+        }
+        int tier;
+        if (closer || prio >= 3) tier = TIER_COMBO;
+        else if (info && !c.isPermanent()) tier = TIER_INFO;
+        else if (ComputerUtil.isRamp(ai, sa) || eff < cost) tier = TIER_MANA;   // ramp, and whatever pays back mana now (rocks, rituals)
+        else if (wipe) tier = TIER_WIPE;
+        else if (removal) tier = TIER_REMOVAL;
+        else if (prio == 2 || (setup > 0 && c.isPermanent())) tier = TIER_ENGINE;
+        else if (pay > 0) tier = TIER_FEEDER;
+        else if (c.isCreature() || c.isCommander()) tier = TIER_BODY;
+        else tier = TIER_REST;
+        if (refills(sa)) tier = TIER_REST;   // patch 78: a refill goes after the plays the hand can still make
+        // patch 74: early, a permanent that makes mana comes down first (the user, 2026-10-18: "ramp has to come down as early
+        // as possible"; Zur cast Escape Protocol, 310, over Arcane Signet, 250, on two lands with its commander waiting)
+        if (tier == TIER_MANA && c.isPermanent() && manaNow(ai) + landDrop(ai) < EARLY_RAMP_UNDER) v += EARLY_RAMP;
+        return new Step(c, sa, cost, eff, tier, v);
+    }
+
+    static void log(final Player ai, final Plan plan, final List<Step> cands) {
+        final Game g = ai.getGame();
+        final StringBuilder sb = new StringBuilder("#FP-PLAN {\"t\": " + g.getPhaseHandler().getTurn() + ", \"seat\": \"" + ai.getName()
+                + "\", \"phase\": \"" + g.getPhaseHandler().getPhase() + "\", \"budget\": " + plan.budget + ", \"restricted\": " + plan.restricted + ", \"reserve\": " + plan.reserve + ", \"steps\": [");
+        boolean first = true;
+        for (final Step s : plan.steps) {
+            sb.append(first ? "" : ", ").append("{\"card\": \"").append(s.card.getName().replace("\"", "")).append("\", \"tier\": \"")
+                    .append(TIER_NAME[s.tier]).append("\", \"cost\": ").append(s.cost).append(", \"value\": ").append(Math.round(s.value))
+                    .append(s.pick == null ? "" : ", \"pick\": \"" + s.pick.replace("\"", "") + "\"").append("}");
+            first = false;
+        }
+        sb.append("], \"left_out\": [");
+        first = true;
+        int n = 0;
+        for (final Step s : cands) {
+            if (plan.rank.containsKey(s.card.getId()) || n >= 4) continue;
+            sb.append(first ? "" : ", ").append("{\"card\": \"").append(s.card.getName().replace("\"", "")).append("\", \"cost\": ").append(s.cost)
+                    .append(", \"value\": ").append(Math.round(s.value))
+                    .append(s.pick == null ? "" : ", \"pick\": \"" + s.pick.replace("\"", "") + "\"").append("}");
+            first = false;
+            n++;
+        }
+        if (!plan.offColor.isEmpty()) {   // patch 84
+            sb.append("], \"off_color\": [");
+            for (int i = 0; i < Math.min(4, plan.offColor.size()); i++) {
+                sb.append(i > 0 ? ", " : "").append("\"").append(plan.offColor.get(i).replace("\"", "")).append("\"");
+            }
+        }
+        final String line = sb.append("]}").toString();
+        final String k = g.getId() + "|" + line.hashCode();
+        if (LOGGED.add(k)) {
+            if (LOGGED.size() > 20000) LOGGED.clear();
+            System.out.println(line);
+        }
+    }
+}
