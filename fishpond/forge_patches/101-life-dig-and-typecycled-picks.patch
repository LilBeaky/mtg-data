+    /** The colored pips of what sa costs now (cost changes in play included). */
+    static List<Integer> pips(final Player ai, final SpellAbility sa) {
+        final List<Integer> out = new ArrayList<>();
+        if (sa == null || sa.getPayCosts() == null || sa.getPayCosts().getTotalMana() == null) {
+            return out;
+        }
+        try {
+            if (sa.getActivatingPlayer() == null) sa.setActivatingPlayer(ai);
+            final forge.game.mana.ManaCostBeingPaid mc = ComputerUtilMana.calculateManaCost(sa.getPayCosts(), sa, ai, true, 0, false);
+            for (final forge.card.mana.ManaCostShard sh : mc.getDistinctShards()) {
+                if (sh.isGeneric() || sh.isPhyrexian() || sh.isOr2Generic() || sh.isSnow()) continue;
+                final int mask = sh.isColorless() ? C_BIT : sh.getColorMask() & 31;
+                if (mask == 0) continue;
+                for (int k = mc.getUnpaidShards(sh); k > 0; k--) out.add(mask);
+            }
+        } catch (final RuntimeException e) { /* no pips we can read: the amount check alone */ }
+        return out;
+    }
