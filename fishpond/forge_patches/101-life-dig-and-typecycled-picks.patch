+    /** fishpond patch 71: a spell that lets every player put a permanent from hand onto the battlefield (Show and Tell). */
+    static boolean symmetricCheat(final SpellAbility x) {
+        return x.getApi() == ApiType.ChangeZone && "Hand".equals(x.getParam("Origin")) && "Battlefield".equals(x.getParam("Destination"))
+                && "Player".equals(x.getParam("DefinedPlayer"));
+    }
