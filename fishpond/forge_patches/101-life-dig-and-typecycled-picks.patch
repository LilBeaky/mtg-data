+    public static double blinkValue(final Player ai, final Card c, final Card toGraveyard) {
+        if (c == null || !c.isCreature()) return -1;
+        final Game g = ai.getGame();
+        if (c.getController() != ai) {
+            if (c.isToken()) return ComputerUtilCard.evaluateCreature(c);
+            final forge.game.combat.Combat combat = g.getCombat();
+            if (combat != null && combat.isAttacking(c) && combat.getDefenderPlayerByAttacker(c) == ai) {
+                return 40 + 10 * Math.max(0, c.getNetCombatDamage());
+            }
+            return -1;
+        }
+        if (c.isToken() || c.isCommander() && c.getOwner() == ai) return -1;
+        double v = 0;
+        for (final forge.game.trigger.Trigger t : c.getTriggers()) {
+            if (t.getMode() != forge.game.trigger.TriggerType.ChangesZone || !"Battlefield".equals(t.getParam("Destination"))
+                    || !t.getParamOrDefault("ValidCard", "").startsWith("Card.Self")) continue;
+            try {
+                for (SpellAbility x = t.ensureAbility(); x != null; x = x.getSubAbility()) {
+                    v += enterValue(ai, c, x, toGraveyard);
+                }
+            } catch (final RuntimeException e) { /* skip */ }
+        }
+        // fishpond patch 98: a persist creature with its counter has to be flickered (the user, 2026-10-23: Glen Elendra "is a
+        // repeatable counter, and she has to get flickered if she has the counter"); a creature that enters prepared and isn't
+        // (Emeritus of Ideation: "Flickering to re-prepare it and repeatedly cast Ancestral Recall is disgusting")
+        if (c.hasKeyword(forge.game.keyword.Keyword.PERSIST) && c.getCounters(forge.game.card.CounterEnumType.M1M1) > 0) v += 350;
+        if (!c.isPrepared() && entersPrepared(c)) v += 250;
+        // patch 92: a "no maximum hand size" creature under a later hand-size limit (Triskaidekaphile before Necrodominance)
+        // comes back with a new timestamp and lifts it: the draw to 13 is on again
+        if (!ai.isUnlimitedHandSize()) {
+            for (final forge.game.staticability.StaticAbility st : c.getStaticAbilities()) {
+                if ("Unlimited".equals(st.getParam("SetMaxHandSize")) && st.getParamOrDefault("Affected", "").equals("You")) v += 300;
+            }
+        }
+        for (final Card a : c.getEnchantedBy()) if (a.getController() == ai) v -= base(a, a.getCMC());
+        return v;
+    }
