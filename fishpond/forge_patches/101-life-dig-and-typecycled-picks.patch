+    /** Extra mana a source makes when tapped, from "whenever ... is tapped for mana, add" triggers (Utopia Sprawl: 1). */
+    static int tapExtra(final Card src, final List<forge.game.trigger.Trigger> extra) {
+        int n = 0;
+        for (final forge.game.trigger.Trigger tr : extra) {
+            try {
+                final Card host = tr.getHostCard();
+                if (!tr.hasParam("ValidCard") || !src.isValid(tr.getParam("ValidCard").split(","), host.getController(), host, null)) continue;
+                final SpellAbility ex = tr.ensureAbility();
+                if (ex == null || (ex.getApi() != ApiType.Mana && ex.getApi() != ApiType.ManaReflected)) continue;
+                n += forge.game.ability.AbilityUtils.calculateAmount(host, ex.getParamOrDefault("Amount", "1"), ex);
+            } catch (final RuntimeException e) { /* skip */ }
+        }
+        return n;
+    }
