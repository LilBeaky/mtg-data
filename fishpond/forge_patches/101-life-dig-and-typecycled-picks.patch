+    /** An untapped land it can still play this turn (one), counted in the turn's mana. */
+    /** fishpond patch 78: sa (or a permanent spell's enter trigger) discards or shuffles away its controller's hand and draws. */
+    public static boolean refills(final SpellAbility sa) {
+        if (sa == null || sa.getHostCard() == null) {
+            return false;
+        }
+        if (chainRefills(sa)) {
+            return true;
+        }
+        final Card host = sa.getHostCard();
+        if (sa.isSpell() && host.isPermanent()) {
+            for (final forge.game.trigger.Trigger t : host.getTriggers()) {
+                if (t.getMode() != forge.game.trigger.TriggerType.ChangesZone || !"Battlefield".equals(t.getParam("Destination"))) {
+                    continue;
+                }
+                try {
+                    if (t.ensureAbility() != null && chainRefills(t.ensureAbility())) {
+                        return true;
+                    }
+                } catch (final RuntimeException e) {
+                    // not one
+                }
+            }
+        }
+        return false;
+    }
