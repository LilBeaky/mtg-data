+    /** The most valuable blink among list (an own creature whose enter trigger matters, an opponent's token or attacker),
+     *  or null when none is worth BLINK_AT. */
+    public static Card bestBlink(final Player ai, final Iterable<Card> list, final Card toGraveyard) {
+        Card best = null;
+        double bv = BLINK_AT;
+        for (final Card c : list) {
+            final double v = blinkValue(ai, c, toGraveyard);
+            if (v >= bv) { bv = v; best = c; }
+        }
+        return best;
+    }
