+        }
+        final Plan p = plan(aic, ai);
+        if (p == null || !p.rank.containsKey(sa.getHostCard().getId())) {
+            return false;
+        }
+        Step me = null;
+        int rest = 0;
+        for (final Step s : p.steps) {
+            if (s.card.getId() == sa.getHostCard().getId()) me = s;
+            else rest += s.cost;
+        }
+        return me != null && me.effCost < me.cost && rest > manaNow(ai) - me.cost;
