+    /** A permanent that gives the seat's commander double strike (Flaming Fist: "commander creatures you own have 'whenever
+     *  this creature attacks, it gains double strike'") doubles its commander damage: the user, 2026-10-17, "weigh Flaming
+     *  Fist very very highly ... it's not hard to get him into 1 shot territory". Worth 150 + 100 per point of the commander's
+     *  power now (Wilson at 2: 350; at 6 with auras: 750); 0 for anything else. */
+    static double commanderDoubler(final Player ai, final Card c) {
+        if (!c.isPermanent()) {
+            return 0;
+        }
+        boolean doubles = false;
+        for (final forge.game.staticability.StaticAbility st : c.getStaticAbilities()) {
+            if (!st.getParamOrDefault("Mode", "").contains("Continuous") || !st.getParamOrDefault("Affected", "").contains("IsCommander")) {
+                continue;
+            }
+            if (st.getParamOrDefault("AddKeyword", "").contains("Double Strike")) {
+                doubles = true;
+            }
+            for (final String t : st.getParamOrDefault("AddTrigger", "").split(" & ")) {
+                final String trig = t.isEmpty() ? "" : c.getSVar(t);
+                final String exec = trig.contains("Execute$ ") ? c.getSVar(trig.replaceAll(".*Execute\\$ (\\w+).*", "$1")) : "";
+                if (exec.contains("Double Strike")) {
+                    doubles = true;
+                }
+            }
+        }
+        if (!doubles) {
+            return 0;
+        }
+        int power = 0;
+        for (final Card k : ai.getCommanders()) {
+            if (k.isCreature() && k != c) power = Math.max(power, k.getNetPower());
+        }
+        return power <= 0 ? 0 : 150 + 100 * power;
+    }
