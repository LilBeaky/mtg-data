+    /** fishpond patch 79: mana an untapped source makes that only some spells may spend (Gwenna, Eyes of Gaea: creature
+     *  spells), which manaNow leaves out; the plan spends it on the steps it may pay for. */
+    static final class Restricted {
+        final int amount;
+        final forge.game.spellability.AbilityManaPart part;
+        Restricted(final int amount, final forge.game.spellability.AbilityManaPart part) { this.amount = amount; this.part = part; }
+        boolean pays(final SpellAbility sa) {
+            try {
+                return part.meetsManaRestrictions(sa);
+            } catch (final RuntimeException e) {
+                return false;
+            }
+        }
+    }
+
+    static List<Restricted> restrictedMana(final Player p) {
+        final List<Restricted> out = new ArrayList<>();
+        for (final Card src : p.getCardsIn(ZoneType.Battlefield)) {
+            int free = 0, best = 0;
+            forge.game.spellability.AbilityManaPart bestPart = null;
+            for (final SpellAbility ma : src.getManaAbilities()) {
+                try {
+                    ma.setActivatingPlayer(p);
+                    final forge.game.spellability.AbilityManaPart mp = ma.getManaPart();
+                    if (mp == null || !ma.canPlay()) continue;
+                    final int cost = ma.getPayCosts().getCostMana() != null ? ma.getPayCosts().getCostMana().convertAmount() : 0;
+                    final int made = forge.game.ability.AbilityUtils.calculateAmount(src, ma.getParamOrDefault("Amount", "1"), ma) - cost;
+                    if (mp.getManaRestrictions().isEmpty()) {
+                        free = Math.max(free, made);
+                    } else if (made > best) {
+                        best = made;
+                        bestPart = mp;
+                    }
+                } catch (final RuntimeException e) { /* skip an ability whose check throws */ }
+            }
+            if (free == 0 && bestPart != null) out.add(new Restricted(best, bestPart));   // a source manaNow counted isn't counted twice
+        }
+        return out;
+    }
