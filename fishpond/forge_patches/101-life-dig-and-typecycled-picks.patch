     }
 
     static boolean shieldNow(final Player ai) {
+        // fishpond patch 101: a dig coming at the end step (DrawAi.lifeDig): one or two shields make it nearly free at any life
+        // (the user, 2026-10-24: "You can pay 1 or 2 mana into it and recover all the life from the cards you draw")
+        final PhaseHandler ph = ai.getGame().getPhaseHandler();
+        if (ph.isPlayerTurn(ai) && ph.is(PhaseType.MAIN2) && forge.ai.TurnPlan.lifeDraw(ai) && drawShields(ai) < DIG_SHIELDS
