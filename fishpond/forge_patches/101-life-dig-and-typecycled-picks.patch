+    // ---- fishpond patch 99: Approach of the Second Sun's second cast (the user, 2026-10-23: "Cast an Approach, Zur fetches
+    // Necrodominance, rip to Approach, Win on 9"; "tutor -> Approach -> tutor Approach again is a line to keep"). Once the
+    // first cast resolved (its ApproachingSuns effect in the command zone), the Approach it put seventh from the top waits in
+    // the library: nothing shuffles it away (as patch 89's tutored top cards), Necrodominance's end-step payment draws down to
+    // it, and a first Approach waits for main 2 when the seat's attack trigger would search (and shuffle) this turn. ----
+    /** The library index of an Approach whose next cast from hand wins (its first resolved), or -1. */
+    public static int approachWaiting(final Player ai) {
+        boolean armed = false;
+        for (final Card k : ai.getCardsIn(ZoneType.Command)) if ("ApproachingSuns".equals(k.getName())) armed = true;
+        if (!armed) return -1;
+        final List<Card> lib = new ArrayList<>(ai.getCardsIn(ZoneType.Library));
+        for (int i = 0; i < lib.size(); i++) if (selfPlacingWin(lib.get(i))) return i;
+        return -1;
+    }
