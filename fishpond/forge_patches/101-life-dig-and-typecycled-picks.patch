+            for (final Card k : forge.game.card.CardLists.getValidCards(ai.getCardsIn(ZoneType.Battlefield), sac.getType().split(";"), ai, sa.getHostCard(), sa)) {
+                if (k.isToken() || k.isCreature() && k.getCMC() <= 2 && k.getNetPower() <= 2) return true;
