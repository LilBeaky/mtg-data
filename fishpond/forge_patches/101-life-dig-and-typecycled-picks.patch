-    // ---- fishpond patch 84: colors (the user, 2026-10-21: "it'll make better calls. We have to make sure it holds the right
-    // colors for interaction too. A big part of this simulator is going to be testing how a deck does with its colors.") ----
-    // A unit is one mana the seat can make now, as the set of colors it could be (bits W U B R G, and C_BIT for colorless): a
-    // dual land is W|U, a Talisman W|U|C, Sol Ring two units of C. A pip is one colored symbol of a cost, as the colors that pay
-    // it (a hybrid pip two). Generic mana, Phyrexian and 2/W pips are left to the amount check.
-    static final int C_BIT = 32, ANY = 63;
-    static final String[] COLOR_SHORT = {"W", "U", "B", "R", "G", "C"};
-
-    static int colorsOf(final forge.game.spellability.AbilityManaPart mp, final SpellAbility ma) {
-        int m = 0;
-        if (ma.getApi() == ApiType.ManaReflected) {   // Exotic Orchard, Fellwar Stone: the colors the opponents' lands make
-            try {
-                for (final String c : forge.game.card.CardUtil.getReflectableManaColors(ma)) {
-                    final byte b = forge.card.MagicColor.fromName(c);
-                    m |= b == 0 ? C_BIT : b & 31;
-                }
-            } catch (final RuntimeException e) { /* unknown */ }
-            return m;
-        }
-        for (int i = 0; i < 6; i++) {
-            try {
-                if (mp.canProduce(COLOR_SHORT[i], ma)) m |= 1 << i;
-            } catch (final RuntimeException e) { /* skip */ }
-        }
-        return m;
-    }
