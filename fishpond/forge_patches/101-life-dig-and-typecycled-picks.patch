+    static int manaCost(final SpellAbility sa) {
+        if (sa.getPayCosts() == null || sa.getPayCosts().getTotalMana() == null) {
+            return 0;
+        }
+        return sa.getPayCosts().getTotalMana().getCMC();
+    }
