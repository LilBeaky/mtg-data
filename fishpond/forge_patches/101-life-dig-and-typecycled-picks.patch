+    /** The units left after paying pips (the most specific units first: a Swamp before a dual land), or null if they can't. */
+    static List<Integer> spend(final List<Integer> pips, final List<Integer> units) {
+        final List<Integer> u = new ArrayList<>(units);
+        u.sort(Comparator.comparingInt(Integer::bitCount));
+        final int[] owner = new int[u.size()];
+        Arrays.fill(owner, -1);
+        for (int i = 0; i < pips.size(); i++) {
+            if (!augment(i, pips, u, owner, new boolean[u.size()])) {
+                return null;
+            }
+        }
+        final List<Integer> out = new ArrayList<>();
+        for (int j = 0; j < u.size(); j++) if (owner[j] < 0) out.add(u.get(j));
+        return out;
+    }
