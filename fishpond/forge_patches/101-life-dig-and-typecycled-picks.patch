+    /** fishpond patch 73: c's transmute ability, when c is in hand and the library holds a card of its mana value. */
+    public static SpellAbility transmuteOf(final Player ai, final Card c) {
+        if (!c.isInZone(ZoneType.Hand) || !c.hasStartOfKeyword("Transmute")) {
+            return null;
+        }
+        boolean target = false;
+        for (final Card l : ai.getCardsIn(ZoneType.Library)) {
+            if (l.getCMC() == c.getCMC()) {
+                target = true;
+                break;
+            }
+        }
+        if (!target) {
+            return null;
+        }
+        for (final SpellAbility sa : c.getAllSpellAbilities()) {
+            if (!sa.isSpell() && sa.getApi() == ApiType.ChangeZone && "Hand".equals(sa.getParam("ActivationZone"))
+                    && "Library".equals(sa.getParam("Origin"))) {
+                sa.setActivatingPlayer(ai);
+                return sa;
+            }
+        }
+        return null;
+    }
