+    /** fishpond patch 79: what sa costs to cast now: its printed cost, the commander's tax and the cost changes in play
+     *  (Emerald Medallion, Goreclaw); the printed mana value left Klauth out of a plan that could pay for him (2026-10-20). */
+    static int payCost(final Player ai, final SpellAbility sa) {
+        if (sa.getPayCosts() == null || sa.getPayCosts().getTotalMana() == null) {
+            return 0;
+        }
+        final Card c = sa.getHostCard();
+        final int printed = manaCost(sa) + (c != null && c.isCommander() && c.isInZone(ZoneType.Command) ? 2 * ai.getCommanderCast(c) : 0);
+        try {
+            if (sa.getActivatingPlayer() == null) sa.setActivatingPlayer(ai);
+            return Math.max(0, ComputerUtilMana.calculateManaCost(sa.getPayCosts(), sa, ai, true, 0, false).getConvertedManaCost());
+        } catch (final RuntimeException e) {
+            return printed;
+        }
+    }
