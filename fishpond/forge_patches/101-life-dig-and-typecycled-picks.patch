+    /** fishpond patch 101: c's typecycling ability wherever c is (a tutor's pick in the library), when its search finds something. */
+    static SpellAbility typecycleAbility(final Player ai, final Card c) {
+        for (final SpellAbility sa : c.getAllSpellAbilities()) {
+            if (sa.isSpell() || !sa.isCycling() || sa.getApi() != ApiType.ChangeZone || !"Library".equals(sa.getParam("Origin"))) {
+                continue;
+            }
+            try {
+                sa.setActivatingPlayer(ai);
+                final String type = sa.getParamOrDefault("ChangeType", "Card");
+                if (!forge.game.card.CardLists.getValidCards(ai.getCardsIn(ZoneType.Library), type.split(","), ai, c, sa).isEmpty()) {
+                    return sa;
+                }
+            } catch (final RuntimeException e) { /* no search we can judge */ }
+        }
+        return null;
+    }
