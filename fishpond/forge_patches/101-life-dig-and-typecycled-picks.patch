-    /** A spell or ability outside the plan that would leave too little mana for the rest of it (and what Phase 3 keeps). */
-    public static boolean refuse(final AiController aic, final Player ai, final SpellAbility sa) {
-        if (!active(ai) || sa == null || sa.getHostCard() == null || sa.isManaAbility() || sa.isLandAbility()) {
-            return false;
-        }
-        final Plan p = plan(aic, ai);
-        if (p == null || p.rank.containsKey(sa.getHostCard().getId())) {
-            return false;
-        }
-        // patch 95: under a spell lock (Rule of Law), an unplanned spell would take the cast a planned one needs
-        if (sa.isSpell()) {
-            final int[] lim = spellsLeft(ai);
-            for (final Step s : p.steps) {
-                if (s.sa.isSpell() && (lim[0] >= 0 || lim[1] >= 0 && !s.card.isCreature() && !sa.getHostCard().isCreature())) {
-                    return true;
-                }
-            }
-        }
-        // patch 84: nor one whose colors would leave the plan's, or the held answer's, unpayable ({1}{U} off the Island
-        // Counterspell needs)
-        if ((!p.steps.isEmpty() || !p.keepPips.isEmpty()) && !sa.getHostCard().getName().equals(p.answer)) {
-            final List<Integer> mine = pips(ai, sa);
-            if (!mine.isEmpty()) {
-                final List<Integer> rest = new ArrayList<>(p.keepPips), units = new ArrayList<>(p.units);
-                for (final Step s : p.steps) { rest.addAll(s.pips); units.addAll(s.units); }
-                if (fits(rest, units) && !fits(concat(rest, mine), units)) {
-                    return true;
-                }
