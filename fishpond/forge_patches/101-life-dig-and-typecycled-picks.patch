+    static Plan build(final AiController aic, final Player ai) {
+        final Plan plan = new Plan();
+        final Set<Integer> declined = declined(ai);
+        final List<Step> cands = new ArrayList<>();
+        final List<Card> pool = new ArrayList<>(ai.getCardsIn(ZoneType.Hand));
+        for (final Card c : ai.getCardsIn(ZoneType.Command)) if (c.isCommander() && c.getOwner() == ai) pool.add(c);
+        plan.budget = manaNow(ai) + landDrop(ai);
+        final java.util.function.ToIntFunction<Player> hk = HOLD_KEEP;
+        plan.reserve = hk == null ? 0 : Math.max(0, hk.applyAsInt(ai));
+        final int room = plan.budget - plan.reserve;
+        int laterCost = 0;   // patch 89: a top tutor waiting for main 2 keeps its mana and colors
+        final List<Integer> laterPips = new ArrayList<>();
+        for (final Card c : pool) {
+            if (c.isLand() || declined.contains(c.getId())) {
+                continue;
+            }
