-            return;
-        }
-        final Object[] c = CACHE.get(ai);
-        if (c != null && ((Plan) c[1]).rank.containsKey(sa.getHostCard().getId())) {
-            for (final Step s : ((Plan) c[1]).steps) {
-                if (s.card.getId() == sa.getHostCard().getId() && s.sa.isSpell() != sa.isSpell()) {
-                    return;   // patch 73: the plan wants the card's other play (a transmute, not the spell Forge passed on)
-                }
-            }
-            declined(ai).add(sa.getHostCard().getId());
-            CACHE.remove(ai);
-        }
