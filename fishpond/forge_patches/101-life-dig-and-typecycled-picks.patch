+    /** fishpond patch 83: c's typecycling ability (Wizardcycling), when c is in hand and the search has something to find. */
+    public static SpellAbility typecycleOf(final Player ai, final Card c) {
+        if (!c.isInZone(ZoneType.Hand)) {
+            return null;
+        }
+        return typecycleAbility(ai, c);
+    }
