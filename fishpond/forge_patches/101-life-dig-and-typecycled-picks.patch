+    /** fishpond patch 71: Show and Tell gives every opponent a free permanent, so it is cast only for a card of mana value 6 or
+     *  more, or one the seat can't afford this turn (the user, 2026-10-18: Yusri put Rhystic Study in, a card it could cast for
+     *  the same mana, and Erebos got the Archfiend of Despair that killed it). */
+    public static boolean cheatWasted(final Player ai, final SpellAbility sa) {
+        if (sa == null || !sa.isSpell() || sa.getHostCard() == null) {
+            return false;
+        }
+        boolean cheat = false;
+        for (SpellAbility x = sa; x != null; x = x.getSubAbility()) {
+            cheat |= symmetricCheat(x);
+        }
+        if (!cheat) {
+            return false;
+        }
+        final int afford = manaNow(ai) + landDrop(ai);
+        for (final Card h : ai.getCardsIn(ZoneType.Hand)) {
+            if (h != sa.getHostCard() && h.isPermanent() && !h.isLand() && (h.getCMC() >= 6 || h.getCMC() > afford)) {
+                return false;
+            }
+        }
+        return true;
+    }
