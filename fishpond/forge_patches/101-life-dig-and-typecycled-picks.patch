+    /** Every pip gets a unit of its own that can pay it (a bipartite matching, augmenting paths). */
+    static boolean fits(final List<Integer> pips, final List<Integer> units) {
+        if (pips.isEmpty()) {
+            return true;
+        }
+        if (pips.size() > units.size()) {
+            return false;
+        }
+        final int[] owner = new int[units.size()];
+        Arrays.fill(owner, -1);
+        for (int i = 0; i < pips.size(); i++) {
+            if (!augment(i, pips, units, owner, new boolean[units.size()])) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static boolean augment(final int i, final List<Integer> pips, final List<Integer> units, final int[] owner, final boolean[] seen) {
+        for (int j = 0; j < units.size(); j++) {
+            if (seen[j] || (pips.get(i) & units.get(j)) == 0) continue;
+            seen[j] = true;
+            if (owner[j] < 0 || augment(owner[j], pips, units, owner, seen)) {
+                owner[j] = i;
+                return true;
+            }
+        }
+        return false;
+    }
