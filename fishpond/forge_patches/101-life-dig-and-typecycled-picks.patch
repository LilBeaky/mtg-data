+    /** The library search in sa's chain, or in its card's "when this enters" trigger: a hidden-origin ChangeZone from the
+     *  library into hand, onto the battlefield or onto the library top, for nonland cards. */
+    static SpellAbility search(final SpellAbility sa) {
