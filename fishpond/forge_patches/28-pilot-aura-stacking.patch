+    /** fishpond patch 28 (D4): the pilot's pump-aura target: the best creature, with a bonus for one this seat already
+     *  enchanted or equipped (the user's rule: double-committing to a body is good, a voltron deck wants it) and a smaller
+     *  one for its own commander. Non-creature candidates only when there is no creature. */
+    static Card pilotPumpTarget(final Player ai, final List<Card> prefList) {
+        Card best = null;
+        int bestScore = Integer.MIN_VALUE;
+        for (final Card c : prefList) {
+            if (!c.isCreature()) {
+                continue;
+            }
+            int score = ComputerUtilCard.evaluateCreature(c);
+            int mine = 0;
+            for (final Card a : c.getAttachedCards()) {
+                if (ai.equals(a.getController()) && (a.isAura() || a.isEquipment())) {
+                    mine++;
+                }
+            }
+            if (mine > 0) {
+                score += 60 + 25 * (mine - 1);
+            }
+            if (c.isCommander() && ai.equals(c.getOwner())) {
+                score += 30;
+            }
+            if (score > bestScore) {
+                bestScore = score;
+                best = c;
+            }
+        }
+        return best != null ? best : ComputerUtilCard.getBestAI(prefList);
+    }
