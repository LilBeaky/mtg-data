+    /** fishpond patch 66: a card cast as a copy (PlayEffect CopyCard: Paradigm, Isochron Scepter, Spellbinder) is made on
+     *  the fly and lives in no zone, so the copy of the game has nothing to map it to; the one-move check on casting it threw
+     *  "Couldn't map" (Decorum Dissertation's Paradigm, plan2_20261017: 4 lookahead fallbacks). The same copy is made in the
+     *  copied game: the same printed card, the same piece type, copying the counterpart of the card it copies. */
+    public Card findOrMakeCastCopy(final Card c) {
+        Card result = findCardOrNull(c);
+        if (result != null || c.getPaperCard() == null || c.getCopiedPermanent() == null) {
+            return result;
+        }
+        final Player owner = playerMap.get(c.getController());
+        if (owner == null) {
+            return null;
+        }
+        result = Card.fromPaperCard(c.getPaperCard(), owner);
+        result.setGamePieceType(c.getGamePieceType());
+        final Card original = findCardOrNull(c.getCopiedPermanent());
+        result.setCopiedPermanent(original != null ? original : result);
+        cardMap.put(c, result);
+        return result;
+    }
+
