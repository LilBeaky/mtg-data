+    /** fishpond patch 50: with a lifelink counter engine out, a pinger with X counters in hand (Walking Ballista) is cast for the
+     *  most X that leaves the mana of a lifelink grant open, if that X is at least 2; Forge cast it for X=1. */
+    private SpellAbility castPingerForX() {
+        int grant = -1;
+        for (final Card g : player.getCardsIn(ZoneType.Battlefield)) {
+            for (final SpellAbility a : g.getSpellAbilities()) {
+                if (a.isActivatedAbility() && a.getApi() == ApiType.Pump && a.usesTargeting() && a.getParamOrDefault("KW", "").contains("Lifelink")
+                        && a.getPayCosts() != null && a.getPayCosts().getTotalMana() != null) {
+                    final int c = a.getPayCosts().getTotalMana().getCMC();
+                    grant = grant < 0 ? c : Math.min(grant, c);
