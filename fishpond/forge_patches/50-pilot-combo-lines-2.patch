+    /** fishpond patch 50: a spell that puts a permanent from its caster's hand onto the battlefield (Show and Tell) with a
+     *  permanent of mana value 7+ in hand to put, worth more than its own cost says. Forge orders candidates by mana value, so
+     *  Yusri hard-cast Prismari (7) with Show and Tell and Jin-Gitaxias (10) in hand, and Show and Tell then couldn't be paid
+     *  for (study150_20261014_p49 V09 g0, 1 of 5 games available). It goes ahead of the others; its own "only when" hint
+     *  (Show and Tell: a 4+ permanent in hand) and the one-move check still apply. */
+    private boolean cheatsInBig(final SpellAbility sa) {
+        if (sa == null || !sa.isSpell() || sa.getApi() != ApiType.ChangeZone || !"Hand".equals(sa.getParam("Origin"))
+                || !"Battlefield".equals(sa.getParam("Destination"))) {
+            return false;
