+    /** fishpond patch 75: a mode that only adds to its caster: mana, cards (drawn, or dug to hand or exile to play), tokens, life,
+     *  scry or surveil, for its caster, with nothing in its chain that costs the caster (a discard, life loss, sacrifice or damage). */
+    static boolean freeValueMode(final AbilitySub sub) {
+        final java.util.EnumSet<forge.game.ability.ApiType> good = java.util.EnumSet.of(forge.game.ability.ApiType.Mana,
+                forge.game.ability.ApiType.Draw, forge.game.ability.ApiType.Dig, forge.game.ability.ApiType.Token,
+                forge.game.ability.ApiType.GainLife, forge.game.ability.ApiType.Scry, forge.game.ability.ApiType.Surveil);
+        if (sub.getApi() == null || !good.contains(sub.getApi())) {
+            return false;
+        }
+        for (SpellAbility x = sub; x != null; x = x.getSubAbility()) {
+            final String def = x.getParamOrDefault("Defined", "You");
+            if (x.getApi() != null && good.contains(x.getApi()) && !"You".equals(def)) {
+                return false;
+            }
+            if (x.getApi() == forge.game.ability.ApiType.Discard || x.getApi() == forge.game.ability.ApiType.LoseLife
+                    || x.getApi() == forge.game.ability.ApiType.Sacrifice || x.getApi() == forge.game.ability.ApiType.DealDamage) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** fishpond patch 75: a free mode that targets a player (Jeska's Will counts the target's hand) aims at the opponent with the
+     *  most cards in hand; false when it targets something else. */
+    static boolean targetRichestOpponent(final Player ai, final AbilitySub sub) {
+        if (sub.getTargetRestrictions() == null || !sub.getTargetRestrictions().canTgtPlayer()) {
+            return false;
+        }
+        Player best = null;
+        for (final Player o : ai.getOpponents()) {
+            if (!o.hasLost() && sub.canTarget(o) && (best == null || o.getCardsIn(forge.game.zone.ZoneType.Hand).size() > best.getCardsIn(forge.game.zone.ZoneType.Hand).size())) {
+                best = o;
+            }
+        }
+        if (best == null) {
+            return false;
+        }
+        sub.resetTargets();
+        sub.getTargets().add(best);
+        return true;
+    }
