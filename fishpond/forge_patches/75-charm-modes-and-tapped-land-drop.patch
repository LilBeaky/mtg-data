+    /** fishpond patch 75: a land that would enter tapped (patch 26's check: its Tap replacement with conditions met), not one
+     *  whose controller can pay to have it untapped (shock lands: patch 72 pays when the mana is wanted). */
+    static boolean entersTapped(final Player ai, final Card land) {
+        final java.util.Map<forge.game.ability.AbilityKey, Object> rep = forge.game.ability.AbilityKey.mapFromAffected(land);
+        rep.put(forge.game.ability.AbilityKey.Origin, land.getZone().getZoneType());
+        rep.put(forge.game.ability.AbilityKey.Destination, ZoneType.Battlefield);
+        final forge.game.GameEntityCounterTable table = new forge.game.GameEntityCounterTable();
+        rep.put(forge.game.ability.AbilityKey.EffectOnly, true);
+        rep.put(forge.game.ability.AbilityKey.CounterTable, table);
+        rep.put(forge.game.ability.AbilityKey.CounterMap, table.column(land));
+        try {
+            for (final forge.game.replacement.ReplacementEffect re : ai.getGame().getReplacementHandler().getReplacementList(
+                    forge.game.replacement.ReplacementType.Moved, rep, forge.game.replacement.ReplacementLayer.Other)) {
+                final SpellAbility reSA = re.ensureAbility();
+                if (reSA == null || reSA.getApi() != ApiType.Tap || reSA.hasParam("UnlessCost")) {
+                    continue;
+                }
+                reSA.setActivatingPlayer(ai);
+                if (reSA.metConditions()) {
+                    return true;
+                }
+            }
+        } catch (final RuntimeException e) {
+            return false;
+        }
+        return false;
+    }
