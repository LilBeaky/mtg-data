+    // ---- fishpond patch 24: commander combat safety (the user's rules, 2026-10-04) ----
+    // A pilot seat's commander attacks only a player none of whose untapped creatures can kill it in a block (first
+    // strike, deathtouch and pumps the AI can see count; indestructible survives): it moves to a safe opponent, or stays
+    // home. A commander whose attack trigger gets value now (Yusri's flips, Zur's search, Klauth's mana) still attacks.
+    private void commanderAttackSafety(final Combat combat) {
+        if (!AiController.commanderRulesOn() || !forge.ai.ability.DrawAi.pilotSeat(ai)) {
+            return;
+        }
+        for (final Card att : new ArrayList<>(combat.getAttackers())) {
+            if (!att.isCommander() || !ai.equals(att.getController()) || hasAttackTrigger(att)) {
+                continue;
+            }
+            final Player defender = defendingPlayer(combat.getDefenderByAttacker(att));
+            if (defender == null || !canKillInBlock(att, defender, combat)) {
+                continue;
+            }
+            combat.removeFromCombat(att);
+            for (final Player o : ai.getOpponents()) {
+                if (o != defender && CombatUtil.canAttack(att, o) && !canKillInBlock(att, o, combat)) {
+                    combat.addAttacker(att, o);
+                    break;
+                }
+            }
+        }
+    }
+
+    private static Player defendingPlayer(final GameEntity def) {
+        return def instanceof Player ? (Player) def : def instanceof Card ? ((Card) def).getController() : null;
+    }
+
+    private boolean canKillInBlock(final Card att, final Player defender, final Combat combat) {
+        for (final Card b : defender.getCreaturesInPlay()) {
+            if (b.isUntapped() && CombatUtil.canBlock(att, b) && ComputerUtilCombat.canDestroyAttacker(ai, att, b, combat, false)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean hasAttackTrigger(final Card c) {
+        for (final forge.game.trigger.Trigger t : c.getTriggers()) {
+            if (t.getMode() == forge.game.trigger.TriggerType.Attacks && !t.isStatic()
+                    && "Card.Self".equals(t.getParamOrDefault("ValidCard", ""))) {
+                return true;
+            }
+        }
+        return false;
+    }
