+    private boolean cumulativeUpkeepWorthIt(final Cost cost) {
+        final int mana = cost.getTotalMana() == null ? 0 : cost.getTotalMana().getCMC();
+        if (mana <= 0) {
+            return true;
+        }
+        final int available = ComputerUtilMana.getAvailableManaEstimate(player, false);
+        if (mana * 2 > available) {
+            return false;
+        }
+        for (final Card c : player.getCardsIn(ZoneType.Command)) {
+            if (c.isCommander() && player.equals(c.getOwner())) {
+                final int need = c.getCMC() + 2 * player.getCommanderCast(c);
+                if (available >= need && available - mana < need) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
