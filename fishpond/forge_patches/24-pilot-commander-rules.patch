+    // ---- fishpond patch 24: commander timing ----
+    // Forge cast commanders about a turn late: it spent the mana on other spells first (Klauth with 8 mana on turn 4 was out
+    // by turn 5 in a quarter of games; Niv first cast on turns 5-10). The user's rule (2026-10-04): cast the commander as
+    // soon as it's affordable unless something more urgent is in hand. For a pilot seat in its own main phase, a commander
+    // spell from the command zone goes first and isn't held by the "cast later" checks or hybrid's one-move veto, unless
+    // the seat is facing lethal (then the survival plays come first), its cost has X, or its deck says
+    // '# commander: hold' (the harness lists those commanders in -Dfishpond.commanderHold, ';'-separated names).
+    /** Patch 24's commander rules (timing, cumulative upkeep, combat safety); -Dfishpond.commanderRules=false for A/B runs. */
+    public static boolean commanderRulesOn() {
+        return !"false".equals(System.getProperty("fishpond.commanderRules"));
+    }
+
+    private boolean commanderNow(final SpellAbility sa) {
+        final Card c = sa.getHostCard();
+        if (!commanderRulesOn() || c == null || !sa.isSpell() || !c.isCommander() || !c.isInZone(ZoneType.Command) || !forge.ai.ability.DrawAi.pilotSeat(player)) {
+            return false;
+        }
+        final forge.game.phase.PhaseHandler ph = game.getPhaseHandler();
+        if (!ph.isPlayerTurn(player) || ph.getPhase() == null || !ph.getPhase().isMain()) {
+            return false;
+        }
+        final String hold = System.getProperty("fishpond.commanderHold", "");
+        if (!hold.isEmpty() && Arrays.asList(hold.split(";")).contains(c.getName())) {
+            return false;
+        }
+        if (sa.getPayCosts() != null && sa.getPayCosts().hasXInAnyCostPart()) {
+            return false;
+        }
+        return !ComputerUtil.aiLifeInDanger(player, true, 0);
+    }
