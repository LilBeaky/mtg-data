+    /** fishpond patch 69: an attack trigger that gives the attacker double strike (Flaming Fist: "commander creatures you own have
+     *  'whenever this creature attacks, it gains double strike until end of turn'"). The keyword shows only once it attacks, so the
+     *  next-combat prediction read Wilson's commander damage at half and released the blockers that kept him from 21. */
+    public static boolean attackGrantsDoubleStrike(final Card attacker) {
+        for (final Trigger t : attacker.getTriggers()) {
+            if (t.getMode() != TriggerType.Attacks) {
+                continue;
+            }
+            SpellAbility ex;
+            try {
+                ex = t.ensureAbility();
+            } catch (final RuntimeException e) {
+                continue;
+            }
+            for (SpellAbility x = ex; x != null; x = x.getSubAbility()) {
+                if (x.getApi() != ApiType.Pump || !x.getParamOrDefault("KW", "").contains("Double Strike")) {
+                    continue;
+                }
+                final String def = x.getParamOrDefault("Defined", "Self");
+                if (def.equals("Self") || def.startsWith("TriggeredAttacker")) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
