+    public static double blinkValue(final Player ai, final Card c, final Card toGraveyard) {
+        if (c == null || !c.isCreature()) return -1;
+        final Game g = ai.getGame();
+        if (c.getController() != ai) {
+            if (c.isToken()) return ComputerUtilCard.evaluateCreature(c);
+            final forge.game.combat.Combat combat = g.getCombat();
+            if (combat != null && combat.isAttacking(c) && combat.getDefenderPlayerByAttacker(c) == ai) {
+                return 40 + 10 * Math.max(0, c.getNetCombatDamage());
+            }
+            return -1;
+        }
+        if (c.isToken() || c.isCommander() && c.getOwner() == ai) return -1;
+        double v = 0;
+        for (final forge.game.trigger.Trigger t : c.getTriggers()) {
+            if (t.getMode() != forge.game.trigger.TriggerType.ChangesZone || !"Battlefield".equals(t.getParam("Destination"))
+                    || !t.getParamOrDefault("ValidCard", "").startsWith("Card.Self")) continue;
+            try {
+                for (SpellAbility x = t.ensureAbility(); x != null; x = x.getSubAbility()) {
+                    v += enterValue(ai, c, x, toGraveyard);
+                }
+            } catch (final RuntimeException e) { /* skip */ }
+        }
+        if (c.hasKeyword(forge.game.keyword.Keyword.PERSIST) && c.getCounters(forge.game.card.CounterEnumType.M1M1) > 0) v += 150;
+        for (final Card a : c.getEnchantedBy()) if (a.getController() == ai) v -= base(a, a.getCMC());
+        return v;
+    }
+
+    static double enterValue(final Player ai, final Card host, final SpellAbility x, final Card toGraveyard) {
+        final ApiType api = x.getApi();
+        if (api == ApiType.ChangeZone && x.getParamOrDefault("Origin", "").contains("Graveyard")) {
+            final List<Card> gy = new ArrayList<>(ai.getCardsIn(ZoneType.Graveyard));
+            if (toGraveyard != null && !gy.contains(toGraveyard)) gy.add(toGraveyard);
+            final String valid = x.getParamOrDefault("ValidTgts", x.getParamOrDefault("ChangeType", ""));
+            double best = 0;
+            if (!valid.isEmpty()) {
+                for (final Card k : gy) {
+                    try {
+                        if (!k.isValid(valid.split(","), ai, host, x)) continue;
+                    } catch (final RuntimeException e) { continue; }
+                    double kv = base(k, k.getCMC());
+                    for (final SpellAbility ks : k.getAllSpellAbilities()) {
+                        if (!ks.isSpell() && ks.isCycling() && ks.getApi() == ApiType.ChangeZone) { kv += 150; break; }   // it tutors again
+                    }
+                    best = Math.max(best, kv);
+                }
+            }
+            return best;
+        }
+        if (search(x) != null) return 200;
+        if (api == ApiType.Draw) return 80 * Math.max(1, drawsYou(x));
+        if (api == ApiType.Token) return 60;
+        if (api == null) return 0;
+        return 40;
+    }
+
+    /** The most valuable blink among list (an own creature whose enter trigger matters, an opponent's token or attacker),
