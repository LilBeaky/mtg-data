+    /** The card prevents all damage that would be dealt to its controller (Solitary Confinement). */
+    static boolean preventsDamageToYou(final Card c) {
+        for (final forge.game.replacement.ReplacementEffect re : c.getReplacementEffects()) {
+            if (re.getMode() == forge.game.replacement.ReplacementType.DamageDone && "True".equals(re.getParam("Prevent"))
+                    && "You".equals(re.getParamOrDefault("ValidTarget", ""))) return true;
+        }
+        return false;
+    }
+
+    /** How close the opponents' creatures are to killing the seat (the pilot policy's survival rule): 1 when they all
+     *  together reach its life or one opponent's reach three fifths of it, 0.5 at half or at 10 life, else 0. */
+    static double lethalDanger(final Player ai) {
+        int total = 0, most = 0;
+        for (final Player o : ai.getOpponents()) {
+            if (o.hasLost()) continue;
+            int pw = 0;
+            for (final Card k : o.getCreaturesInPlay()) pw += Math.max(0, k.getNetCombatDamage());
