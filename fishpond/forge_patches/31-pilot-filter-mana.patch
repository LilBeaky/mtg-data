+    /** One entry per mana the ability makes: the colors that mana may be ("W", or "W B" for a combo). */
+    static List<String> pilotConverterOutput(final SpellAbility m) {
+        final List<String> out = new ArrayList<>();
+        final AbilityManaPart mp = m.getManaPart();
+        int amount;
+        try {
+            amount = AbilityUtils.calculateAmount(m.getHostCard(), m.getParamOrDefault("Amount", "1"), m);
+        } catch (RuntimeException e) {
+            amount = 1;
+        }
+        if (mp.isComboMana()) {
+            final String opts = mp.getComboColors(m).trim();
+            for (int i = 0; i < amount && !opts.isEmpty(); i++) {
+                out.add(opts);
+            }
+            return out;
+        }
+        for (int i = 0; i < amount; i++) {
+            for (final String t : mp.getOrigProduced().trim().split("\\s+")) {
+                if (t.length() == 1 && "WUBRGC".contains(t)) {
+                    out.add(t);
+                }
+            }
+        }
+        return out;
+    }
