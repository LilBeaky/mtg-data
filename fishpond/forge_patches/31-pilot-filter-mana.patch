+    /** Untapped mana abilities whose cost is mana plus {T} and nothing else (Signets, filter lands, Cabal Coffers). */
+    static List<SpellAbility> pilotConverters(final Player ai, final SpellAbility paying) {
+        final List<SpellAbility> out = new ArrayList<>();
+        for (final Card c : ai.getCardsIn(ZoneType.Battlefield)) {
+            if (c.isTapped() || c == paying.getHostCard()) {
+                continue;
+            }
+            for (final SpellAbility m : c.getManaAbilities()) {
+                if (m.getApi() != ApiType.Mana || m.getManaPart() == null) {
+                    continue;
+                }
+                final Cost cost = m.getPayCosts();
+                if (!cost.hasManaCost() || !cost.hasTapCost()) {
+                    continue;
+                }
+                boolean other = false;
+                for (final CostPart part : cost.getCostParts()) {
+                    if (!(part instanceof CostPartMana) && !(part instanceof CostTap)) {
+                        other = true;
+                    }
+                }
+                m.setActivatingPlayer(ai);
+                if (!other && m.canPlay()) {
+                    out.add(m);
+                }
+            }
+        }
+        return out;
+    }
