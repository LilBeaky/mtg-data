+    // ---- Fishpond pilot seats: -Dfishpond.pilotSeats=all (default) or a comma list of seat numbers (the "N" in a player
+    // name "Ai(N)-..."); fishpond's '-pilot-' patches only change decisions for those seats, so an A/B run can give the
+    // improvements to one seat. Shared by patches 08 and 09.
+    private static java.util.Set<String> pilotSeats;
+    private static java.util.Set<String> overridden;
+
+    public static boolean pilotSeat(Player p) {
+        if (pilotSeats == null) {
+            String v = System.getProperty("fishpond.pilotSeats", "all");
+            pilotSeats = v.equals("all") ? null : new java.util.HashSet<>(java.util.Arrays.asList(v.split(",")));
+            if (pilotSeats == null) return true;
+        }
+        return p != null && pilotSeats.contains(p.getName().replaceAll("^Ai\\((\\d+)\\).*", "$1"));
+    }
+
+    /** Cards fishpond un-flagged (forge_card_overrides; -Dfishpond.overriddenFile, one name per line): for a seat outside
+     *  the pilot seats the AI treats them as still flagged (patch 09). */
+    public static boolean pilotOverridden(String name) {
+        if (overridden == null) {
+            overridden = new java.util.HashSet<>();
+            String f = System.getProperty("fishpond.overriddenFile");
+            if (f != null) {
+                try { overridden.addAll(java.nio.file.Files.readAllLines(java.nio.file.Paths.get(f))); } catch (java.io.IOException e) { /* none */ }
+            }
+        }
+        return overridden.contains(name);
+    }
