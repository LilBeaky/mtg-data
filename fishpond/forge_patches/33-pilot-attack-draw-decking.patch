+    // ---- fishpond patch 33: attacks whose own draw triggers deck the attacker ----
+    // Yusri g11 (dummy study, 2026-10-07) attacked with Ancient Silver Dragon at 9 cards (roll a d20, draw that many),
+    // holding Laboratory Maniac and Jace with mana up, and decked. Patch 20 counts draws for casts only. A pilot seat
+    // counts the mandatory draws an attacker's combat-damage or attack triggers give it (a die roll counts its largest
+    // result) and attacks only with creatures whose draws leave a card for the next draw step, unless an empty-library
+    // draw wins already; a permanent that wins on that draw (Laboratory Maniac) is cast in main 1, before such an attack.
+    // -Dfishpond.attackDraws=false turns it off.
+    public static boolean attackDrawsOn() {
+        return !"false".equals(System.getProperty("fishpond.attackDraws"));
+    }
+
+    /** Cards the AI must draw when this creature attacks and deals combat damage to a player (its own triggers and the
+     *  AI's other permanents' triggers that match it). */
+    public static int attackDraws(final Player ai, final Card attacker) {
+        int n = 0;
+        for (final Card host : ai.getCardsIn(ZoneType.Battlefield)) {
+            for (final Trigger t : host.getTriggers()) {
+                if (t.getMode() != TriggerType.DamageDone && t.getMode() != TriggerType.Attacks || t.hasParam("OptionalDecider")) {
+                    continue;
+                }
+                if (t.getMode() == TriggerType.DamageDone && (!"True".equals(t.getParam("CombatDamage"))
+                        || !t.getParamOrDefault("ValidTarget", "").matches("(Player|Opponent).*"))) {
+                    continue;
+                }
+                final String valid = t.getParamOrDefault(t.getMode() == TriggerType.Attacks ? "ValidCard" : "ValidSource", "");
+                if (valid.isEmpty() || !attacker.isValid(valid.split(","), ai, host, null)) {
+                    continue;
+                }
+                final java.util.Map<String, Integer> rolls = new java.util.HashMap<>();
+                for (SpellAbility a = t.ensureAbility(); a != null; a = a.getSubAbility()) {
+                    if (a.getApi() == ApiType.RollDice && a.hasParam("ResultSVar")) {
+                        try {
+                            rolls.put(a.getParam("ResultSVar"), Integer.parseInt(a.getParamOrDefault("Sides", "6")) * Integer.parseInt(a.getParamOrDefault("Amount", "1")));
+                        } catch (NumberFormatException e) {
+                            rolls.put(a.getParam("ResultSVar"), 20);
+                        }
+                    }
+                    final String def = a.getParamOrDefault("Defined", "You");
+                    if (a.getApi() != ApiType.Draw || !"You".equals(def) || a.hasParam("OptionalDecider") || a.hasParam("UpTo")) {
+                        continue;
+                    }
+                    final String num = a.getParamOrDefault("NumCards", "1");
+                    if (rolls.containsKey(num)) {
+                        n += rolls.get(num);
+                        continue;
+                    }
+                    try {
+                        n += Math.max(1, AbilityUtils.calculateAmount(host, num, a));
+                    } catch (RuntimeException e) {
+                        n += 1;
+                    }
+                }
+            }
+        }
+        return n;
+    }
+
+    /** True when this attacker's draws could empty the pilot seat's library with no empty-library win in place. */
+    public static boolean attackDecks(final Player ai, final Card attacker) {
+        if (!attackDrawsOn() || !forge.ai.ability.DrawAi.pilotSeat(ai) || winsOnEmptyLibraryDraw(ai)) {
+            return false;
+        }
+        final int draws = attackDraws(ai, attacker);
+        return draws > 0 && ai.getCardsIn(ZoneType.Library).size() - draws < 1;
+    }
+
+    /** A permanent spell that wins on an empty-library draw (Laboratory Maniac, Jace), while a creature that could attack
+     *  this turn is held back because its draws could deck the seat. */
+    public static boolean winCardBeforeAttack(final Player ai, final SpellAbility sa) {
+        final Card c = sa.getHostCard();
+        if (!attackDrawsOn() || !sa.isSpell() || c == null || !c.isPermanent() || !forge.ai.ability.DrawAi.pilotSeat(ai)
+                || !forge.ai.ability.DrawAi.emptyLibraryWinCard(c) || c.isCreature() && c.getTriggers().stream().anyMatch(
+                        t -> t.getMode() == TriggerType.ChangesZone)) {
+            return false;                                   // Thassa's Oracle wins on entering: patch 10 times that one
+        }
+        final forge.game.phase.PhaseHandler ph = ai.getGame().getPhaseHandler();
+        if (!ph.isPlayerTurn(ai) || ph.getPhase() == null || !ph.getPhase().isBefore(forge.game.phase.PhaseType.COMBAT_DECLARE_ATTACKERS)) {
+            return false;
+        }
+        for (final Card a : ai.getCreaturesInPlay()) {
+            if (forge.game.combat.CombatUtil.canAttack(a) && attackDecks(ai, a)) {
+                return true;
+            }
+        }
+        return false;
+    }
