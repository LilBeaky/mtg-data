+    // fishpond patch 33: attackers whose mandatory draw triggers together would empty the library stay home, the
+    // biggest draws first, unless an empty-library draw wins (ComputerUtil.attackDecks)
+    private void pilotAttackDraws() {
+        if (nextTurn || attackers.isEmpty() || !ComputerUtil.attackDrawsOn() || !forge.ai.ability.DrawAi.pilotSeat(ai)
+                || ComputerUtil.winsOnEmptyLibraryDraw(ai)) {
+            return;
+        }
+        final java.util.Map<Card, Integer> draws = new java.util.HashMap<>();
+        int total = 0;
+        for (final Card c : attackers) {
+            final int d = ComputerUtil.attackDraws(ai, c);
+            if (d > 0 && c.getStaticAbilities().stream().noneMatch(st -> st.checkMode(forge.game.staticability.StaticAbilityMode.MustAttack))) {
+                draws.put(c, d);
+                total += d;
+            }
+        }
+        final int lib = ai.getCardsIn(ZoneType.Library).size();
+        final List<Card> byDraws = new ArrayList<>(draws.keySet());
+        byDraws.sort((a, b) -> draws.get(b) - draws.get(a));
+        for (final Card c : byDraws) {
+            if (lib - total >= 1) {
+                break;
+            }
+            attackers.remove(c);
+            total -= draws.get(c);
+        }
+    }
