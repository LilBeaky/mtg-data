+    /** fishpond patch 117: the mana p's sources make next turn, tapped or not now (the best unrestricted ability of each), plus
+     *  a land drop when p holds a land. */
+    public static int nextTurnMana(final Player p) {
+        int total = 0;
+        for (final Card src : p.getCardsIn(ZoneType.Battlefield)) {
+            int best = 0;
+            for (final SpellAbility ma : src.getManaAbilities()) {
+                try {
+                    ma.setActivatingPlayer(p);
+                    final forge.game.spellability.AbilityManaPart mp = ma.getManaPart();
+                    if (mp == null || !mp.getManaRestrictions().isEmpty()) continue;
+                    final int cost = ma.getPayCosts().getCostMana() != null ? ma.getPayCosts().getCostMana().convertAmount() : 0;
+                    final String prod = ma.getParamOrDefault("Produced", "");
+                    final int kinds = prod.startsWith("Combo") || prod.isEmpty() ? 1 : prod.split(" ").length;
+                    best = Math.max(best, kinds * forge.game.ability.AbilityUtils.calculateAmount(src, ma.getParamOrDefault("Amount", "1"), ma) - cost);
+                } catch (final RuntimeException e) { /* skip */ }
+            }
+            total += Math.max(0, best);
+        }
+        for (final Card c : p.getCardsIn(ZoneType.Hand)) {
+            if (c.isLand()) { total++; break; }
+        }
+        return total;
+    }
+
