+    /** fishpond patch 117: the seat's mana next turn (every source untapped, a land drop if it holds a land) covers recasting
+     *  this commander from the command zone with one more tax. */
+    private boolean recastNextTurn(final Card cmd) {
+        final int cost = cmd.getCMC() + 2 * (ai.getCommanderCast(cmd));
+        return TurnPlan.nextTurnMana(ai) >= cost;
+    }
+
+    /** fishpond patch 117: the attackers at p could kill it unblocked. */
+    private static boolean lethalAt(final Combat combat, final Player p) {
+        if (p == null) return false;
+        int dmg = 0;
+        for (final Card a : combat.getAttackersOf(p)) dmg += ComputerUtilCombat.damageIfUnblocked(a, p, combat, false);
+        return dmg >= p.getLife();
+    }
+
     private static Player defendingPlayer(final GameEntity def) {
         return def instanceof Player ? (Player) def : def instanceof Card ? ((Card) def).getController() : null;
     }
