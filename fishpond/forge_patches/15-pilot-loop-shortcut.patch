+    // ---- fishpond patch 15: loop shortcut (docs/FORGE_PLAN.md "Pilot study 2026-10-04" item 1; FORGE_ISSUES #8) ----
+    // A seat that chooses the same play (same card and ability; for lands, the same land) LOOP_DETECT times in one turn
+    // may be looping: its loop play skips hybrid's one-move check and danger checks are frozen (ComputerUtil.aiLifeInDanger).
+    // At LOOP_CONFIRM repeats it is a loop (a few repeats are normal: Erebos's draws, Staff of Domination): other pilot seats
+    // pass priority, and it stops once its creatures beat the table's life after one chump block per opposing creature, or
+    // after -Dfishpond.loopMax iterations; then that play (every land play, for a land loop) is off for the rest of the
+    // turn. Each start and stop prints a #FP-LOOP line.
+    static final int LOOP_DETECT = 3;
+    static final int LOOP_CONFIRM = 10;
+    private static final int LOOP_MAX = Integer.getInteger("fishpond.loopMax", 1000);
+
+    static final class LoopState {
+        int turn = -1;
+        final Map<String, Integer> counts = new HashMap<>();
+        final Set<String> stopped = new HashSet<>();
+        final Map<String, Boolean> danger = new HashMap<>();
+        Player looper;
+        String key;
+        int iterations;
+    }
+
+    private static final Map<Game, LoopState> LOOPS = Collections.synchronizedMap(new WeakHashMap<>());
+
+    static LoopState loopState(final Game g) {
+        final LoopState s = LOOPS.computeIfAbsent(g, k -> new LoopState());
+        final int t = g.getPhaseHandler().getTurn();
+        if (s.turn != t) {
+            s.turn = t;
+            s.counts.clear();
+            s.stopped.clear();
+            s.danger.clear();
+            s.looper = null;
+            s.key = null;
+            s.iterations = 0;
+        }
+        return s;
+    }
+
+    static String loopKey(final SpellAbility sa) {
+        return sa.isLandAbility() ? "land" : sa.getHostCard().getName() + "|" + sa.getDescription();
+    }
+
+    private static String countKey(final SpellAbility sa) {
+        return sa.isLandAbility() ? "land:" + sa.getHostCard().getName() : loopKey(sa);
+    }
+
+    private void noteLoopPlay(final LoopState ls, final SpellAbility sa) {
+        final int n = ls.counts.merge(player.getId() + "#" + countKey(sa), 1, Integer::sum);
+        final String key = loopKey(sa);
+        if (n >= LOOP_DETECT && ls.looper == null && !ls.stopped.contains(player.getId() + "#" + key)) {
+            ls.looper = player;
+            ls.key = key;
+            ls.iterations = n;
+            System.out.println("#FP-LOOP {\"event\": \"start\", \"player\": \"" + player.getName() + "\", \"turn\": " + ls.turn
+                    + ", \"play\": \"" + sa.getHostCard().getName() + "\", \"land\": " + sa.isLandAbility() + "}");
+        } else if (ls.looper == player && key.equals(ls.key)) {
+            ls.iterations = Math.max(ls.iterations + 1, n);
+        } else {
+            return;
+        }
+        if (ls.iterations < LOOP_CONFIRM) {
+            return;
+        }
+        final boolean goal = loopGoalReached(player);
+        if (goal || ls.iterations >= LOOP_MAX) {
+            ls.stopped.add(player.getId() + "#" + key);
+            System.out.println("#FP-LOOP {\"event\": \"stop\", \"player\": \"" + player.getName() + "\", \"turn\": " + ls.turn
+                    + ", \"play\": \"" + sa.getHostCard().getName() + "\", \"iterations\": " + ls.iterations
+                    + ", \"reason\": \"" + (goal ? "goal" : "cap") + "\"}");
+            ls.looper = null;
+            ls.key = null;
+            ls.danger.clear();
+        }
+    }
+
+    /** The looper's creatures, after the opponents chump-block its biggest attackers one each, cover their life. */
+    static boolean loopGoalReached(final Player p) {
+        int life = 0, blockers = 0;
+        for (final Player o : p.getOpponents()) {
+            if (o.hasLost()) {
+                continue;
+            }
+            life += o.getLife();
+            blockers += o.getCreaturesInPlay().size();
+        }
+        if (life <= 0) {
+            return true;
+        }
+        final List<Integer> powers = new ArrayList<>();
+        for (final Card c : p.getCreaturesInPlay()) {
+            powers.add(Math.max(0, c.getNetCombatDamage()));
+        }
+        powers.sort(Collections.reverseOrder());
+        int damage = 0;
+        for (int i = blockers; i < powers.size(); i++) {
+            damage += powers.get(i);
+        }
+        return damage >= life;
+    }
+
+    private boolean loopStopped(final SpellAbility sa) {
+        if (sa == null || sa.getHostCard() == null || !forge.ai.ability.DrawAi.pilotSeat(player)) {
+            return false;
+        }
+        return loopState(game).stopped.contains(player.getId() + "#" + loopKey(sa));
+    }
+
+    private boolean inLoop(final SpellAbility sa) {
+        if (sa.getHostCard() == null || !forge.ai.ability.DrawAi.pilotSeat(player)) {
+            return false;
+        }
+        final LoopState ls = loopState(game);
+        return ls.looper == player && loopKey(sa).equals(ls.key);
+    }
+
+    /** Danger checks while a loop runs: computed once per player and question for the rest of the loop. */
+    public static boolean loopDanger(final Player ai, final String question, final java.util.function.BooleanSupplier compute) {
+        final LoopState ls = LOOPS.get(ai.getGame());
+        if (ls == null || ls.looper == null || ls.turn != ai.getGame().getPhaseHandler().getTurn()) {
+            return compute.getAsBoolean();
+        }
+        return ls.danger.computeIfAbsent(ai.getId() + "#" + question, k -> compute.getAsBoolean());
+    }
