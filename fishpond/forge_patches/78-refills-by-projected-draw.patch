     }
 
     /** An untapped land it can still play this turn (one), counted in the turn's mana. */
+    /** fishpond patch 78: sa (or a permanent spell's enter trigger) discards or shuffles away its controller's hand and draws. */
+    public static boolean refills(final SpellAbility sa) {
+        if (sa == null || sa.getHostCard() == null) {
+            return false;
+        }
+        if (chainRefills(sa)) {
+            return true;
+        }
+        final Card host = sa.getHostCard();
+        if (sa.isSpell() && host.isPermanent()) {
+            for (final forge.game.trigger.Trigger t : host.getTriggers()) {
+                if (t.getMode() != forge.game.trigger.TriggerType.ChangesZone || !"Battlefield".equals(t.getParam("Destination"))) {
+                    continue;
+                }
+                try {
+                    if (t.ensureAbility() != null && chainRefills(t.ensureAbility())) {
+                        return true;
+                    }
+                } catch (final RuntimeException e) {
+                    // not one
+                }
+            }
+        }
+        return false;
+    }
+
+    static boolean chainRefills(final SpellAbility sa) {
+        boolean loses = false, draws = false;
+        for (SpellAbility x = sa; x != null; x = x.getSubAbility()) {
+            final ApiType api = x.getApi();
+            if (api == ApiType.Discard && "Hand".equals(x.getParam("Mode"))) {
+                loses = true;
+            }
+            if (api == ApiType.ChangeZoneAll && x.getParamOrDefault("Origin", "").contains("Hand")   // the whole hand, not one card (Enter the Infinite)
+                    && ("Library".equals(x.getParam("Destination")) || "Graveyard".equals(x.getParam("Destination")) || "Exile".equals(x.getParam("Destination")))) {
+                loses = true;
+            }
+            if (api == ApiType.Draw) {
+                final String d = x.getParamOrDefault("Defined", "You");
+                draws |= d.equals("You") || d.equals("Player");
+            }
+        }
+        return loses && draws;
+    }
+
+    /** fishpond patch 78: the plan has other plays this turn besides sa's card (a refill waits for them). */
+    public static boolean othersPlanned(final AiController aic, final Player ai, final SpellAbility sa) {
+        if (!active(ai)) {
+            return false;
+        }
+        final Plan p = plan(aic, ai);
+        if (p == null) {
+            return false;
+        }
+        for (final Step s : p.steps) {
+            if (s.card.getId() != sa.getHostCard().getId() && !refills(s.sa)) {
+                return true;
+            }
+        }
+        return false;
+    }
