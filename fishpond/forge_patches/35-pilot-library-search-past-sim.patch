         return false;
     }
 
+    // ---- fishpond patch 35: library searches past hybrid's one-move check ----
+    // The one-move check scores the board after a play against the board before. A search to hand, to the top of the
+    // library or to the graveyard trades the search card for the found one, which the score can't see (the found card is
+    // hidden information in the copy): it reads as a card lost, and any life paid for the mana (Elves of Deep Shadow)
+    // tips it under the allowance. Witherbloom's Diabolic Tutor was vetoed on every turn it was considered
+    // (varied_20261012 V02 g2: 336 -> -1863 vs -1856, allowance 5). For a pilot seat the tutor policy already judges what
+    // a search fetches, so these searches skip the check. -Dfishpond.searchPastSim=false turns it off.
+    public static boolean librarySearchPastSim(final Player ai, final SpellAbility sa) {
+        if ("false".equals(System.getProperty("fishpond.searchPastSim")) || !forge.ai.ability.DrawAi.pilotSeat(ai)) {
+            return false;
+        }
+        for (SpellAbility a = sa; a != null; a = a.getSubAbility()) {
+            if ((a.getApi() == ApiType.ChangeZone || a.getApi() == ApiType.ChangeZoneAll) && a.hasParam("ChangeType")
+                    && a.getParamOrDefault("Origin", "").contains("Library")
+                    && a.getParamOrDefault("Destination", "").matches("Hand|Library|Graveyard")) {
+                return true;
+            }
+        }
+        return false;
+    }
+
