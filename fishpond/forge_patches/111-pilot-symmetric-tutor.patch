--- a/forge-ai/src/main/java/forge/ai/AiController.java
+++ b/forge-ai/src/main/java/forge/ai/AiController.java
@@ -4325,6 +4325,21 @@ public class AiController {
     // turns both off.
     public static volatile java.util.function.ToDoubleBiFunction<Player, Card> CARD_THREAT;
     public static volatile java.util.function.ToDoubleBiFunction<Player, SpellAbility> SPELL_THREAT;
+    // fishpond patch 111: a player's threat (how close to winning), for choices that hand an opponent something
+    public static volatile java.util.function.ToDoubleFunction<Player> PLAYER_THREAT;
+
+    /** The opponent of ai least close to winning (the threat model's score; life when there is none), or null. */
+    public static Player leastThreateningOpponent(final Player ai, final java.util.function.Predicate<Player> ok) {
+        final java.util.function.ToDoubleFunction<Player> f = PLAYER_THREAT;
+        Player best = null;
+        double low = Double.MAX_VALUE;
+        for (final Player o : ai.getOpponents()) {
+            if (o.hasLost() || !ok.test(o)) continue;
+            final double v = f != null ? f.applyAsDouble(o) : o.getLife();
+            if (v < low) { low = v; best = o; }
+        }
+        return best;
+    }
     static final boolean THREAT_PLAY = !"false".equals(System.getProperty("fishpond.threatPlay"));
     public static final double THREAT_COUNTER_AT = Double.parseDouble(System.getProperty("fishpond.threatCounterAt", "50"));
     public static final double THREAT_SAVE_BELOW = Double.parseDouble(System.getProperty("fishpond.threatSaveBelow", "20"));
