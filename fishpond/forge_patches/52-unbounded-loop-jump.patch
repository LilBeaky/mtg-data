+    /** The per-iteration change if the last three snapshots show an unbounded loop, else null. */
+    static int[] unboundedDelta(final List<int[]> sigs) {
+        if (sigs.size() < 3) {
+            return null;
+        }
+        final int[] a = sigs.get(sigs.size() - 3), b = sigs.get(sigs.size() - 2), c = sigs.get(sigs.size() - 1);
+        if (a[S_PERMS] != b[S_PERMS] || b[S_PERMS] != c[S_PERMS] || a[S_TURN] != c[S_TURN] || a[S_PHASE] != c[S_PHASE]) {
+            return null;
+        }
+        final int[] d = new int[a.length];
+        for (int i = 0; i < a.length; i++) {
+            if (i == S_PERMS || i == S_GAP || i == S_TURN || i == S_PHASE) {
+                continue;
+            }
+            if (b[i] - a[i] != c[i] - b[i]) {
+                return null;
+            }
+            d[i] = c[i] - b[i];
+        }
+        d[S_GAP] = c[S_GAP] - b[S_GAP];
+        final boolean free = d[S_STACK] == 0 && d[S_MANA] >= 0 && d[S_UNTAPPED] >= 0 && d[S_GY] == 0 && d[S_OPP_ALIVE] == 0 && d[S_OPP_HAND] == 0
+                && d[S_OPP_LIB] == 0 && d[S_OPP_PERMS] == 0 && d[S_LIB] <= 0 && d[S_HAND] == -d[S_LIB];
+        // tokens count as progress only while they bring lethal closer: Saprolings into an opponent's Soul Wardens (2 life
+        // for each 1-power token) are unbounded but pointless, and that loop stops as stalled (patch 48) instead
+        final boolean progress = (d[S_TOKENS] > 0 && d[S_GAP] < 0) || d[S_OPP_LIFE] < 0 || d[S_LIB] < 0;
+        return free && progress ? d : null;
+    }
