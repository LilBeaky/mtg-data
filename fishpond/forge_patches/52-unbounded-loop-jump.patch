+    // ---- fishpond patch 52: unbounded loops jump to their result (the user, 2026-10-15: "here's my loop, response? no?
+    // execute it as many times as it takes") ----
+    // A loop is unbounded when two iterations in a row change the game the same way at no cost: the same untapped mana and
+    // untapped creatures (or more), the same nontoken permanents and graveyard, the opponents' hands, libraries and
+    // permanents unchanged, and each iteration adds something: tokens, opponents' life lost, or cards drawn (drawn cards go
+    // to hand, nothing else leaves it). The opponents had their response windows in the iterations before (patch 15's
+    // shortcut lets them answer the first LOOP_CONFIRM; Forge's own priority passes give them one per iteration until then).
+    // Then the loop's result is applied at once:
+    //   - opponents losing life: every opponent loses the rest of their life (an unbounded drain or ping, Heliod + Ballista);
+    //   - tokens from the loop's own spell (Sprout Swarm): its token effect resolves once for as many iterations as reach
+    //     lethal through blockers (loopGap), at most up to LOOP_BOARD_CAP creatures, and the same share of them is tapped
+    //     as the iterations would have tapped (convoke);
+    //   - draws: down to one card when the player has a card that wins from an empty library (Thassa's Oracle, in hand or
+    //     library: winNowSpell casts it next), else down to LOOP_LIBRARY_FLOOR.
+    // A loop whose iterations don't match, or that adds tokens some other way, keeps running step by step (patch 15).
+    // -Dfishpond.loopJump=false turns it off; -Dfishpond.loopBoardCap sets the cap (200).
+    static final boolean LOOP_JUMP = !"false".equals(System.getProperty("fishpond.loopJump"));
+    static final int LOOP_BOARD_CAP = Integer.getInteger("fishpond.loopBoardCap", 200);
+    private static final int S_MANA = 0, S_UNTAPPED = 1, S_HAND = 2, S_LIB = 3, S_GY = 4, S_PERMS = 5, S_TOKENS = 6, S_LIFE = 7,
+            S_OPP_LIFE = 8, S_OPP_ALIVE = 9, S_OPP_HAND = 10, S_OPP_LIB = 11, S_OPP_PERMS = 12, S_CREATURES = 13, S_GAP = 14,
+            S_TURN = 15, S_PHASE = 16, S_STACK = 17;
+
+    private int[] loopSig() {
+        final int[] s = new int[18];
+        s[S_MANA] = getAvailableManaEstimate(player, true) + player.getManaPool().totalMana();
+        int untapped = 0, tokens = 0;
+        final List<String> perms = new ArrayList<>();
+        for (final Card c : player.getCardsIn(ZoneType.Battlefield)) {
+            if (c.isCreature() && c.isUntapped()) {
+                untapped++;
+            }
+            if (c.isToken()) {
+                tokens++;
+            } else {
+                perms.add(c.getName());
+            }
+        }
+        java.util.Collections.sort(perms);
+        s[S_UNTAPPED] = untapped;
+        s[S_HAND] = player.getCardsIn(ZoneType.Hand).size();
+        s[S_LIB] = player.getCardsIn(ZoneType.Library).size();
+        s[S_GY] = player.getCardsIn(ZoneType.Graveyard).size();
+        s[S_PERMS] = perms.hashCode();
+        s[S_TOKENS] = tokens;
+        s[S_LIFE] = player.getLife();
+        for (final Player o : player.getOpponents()) {
+            if (o.hasLost()) {
+                continue;
+            }
+            s[S_OPP_LIFE] += o.getLife();
+            s[S_OPP_ALIVE]++;
+            s[S_OPP_HAND] += o.getCardsIn(ZoneType.Hand).size();
+            s[S_OPP_LIB] += o.getCardsIn(ZoneType.Library).size();
+            s[S_OPP_PERMS] += o.getCardsIn(ZoneType.Battlefield).size();
+        }
+        s[S_CREATURES] = player.getCreaturesInPlay().size();
+        s[S_GAP] = loopGap(player);
+        s[S_TURN] = game.getPhaseHandler().getTurn();
+        s[S_PHASE] = game.getPhaseHandler().getPhase() == null ? -1 : game.getPhaseHandler().getPhase().ordinal();
+        s[S_STACK] = game.getStack().size();
+        return s;
+    }
