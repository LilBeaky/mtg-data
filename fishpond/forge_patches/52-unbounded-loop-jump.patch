+    private boolean loopJump(final LoopState ls, final SpellAbility sa, final String key) {
+        // a snapshot per iteration, between iterations (chooseSpellAbilityToPlay lets a confirmed loop's leftover triggers
+        // resolve first, so each snapshot holds a whole iteration's effect)
+        if (!game.getStack().isEmpty()) {
+            return false;
+        }
+        ls.sigs.add(loopSig());
+        if (ls.sigs.size() > 3) {
+            ls.sigs.remove(0);
+        }
+        final int[] d = unboundedDelta(ls.sigs);
+        if (d == null || inSimulation()) {
+            return false;
+        }
+        final int[] s = ls.sigs.get(ls.sigs.size() - 1);
+        String reason;
+        int cycles = 0, made = 0, drawn = 0;
+        if (d[S_OPP_LIFE] < 0) {
+            // an unbounded drain or ping: every opponent loses
+            for (final Player o : Lists.newArrayList(player.getOpponents())) {
+                if (!o.hasLost() && o.getLife() > 0) {
+                    o.loseLife(o.getLife(), false, false, sa);
+                }
+            }
+            cycles = (s[S_OPP_LIFE] + (-d[S_OPP_LIFE]) - 1) / (-d[S_OPP_LIFE]);
+            reason = "lethal";
+        } else {
+            int n = Integer.MAX_VALUE;
+            SpellAbility tokenSa = null;
+            String tokenReason = null;   // decided from the arithmetic: triggers of the new tokens haven't resolved yet
+            if (d[S_TOKENS] > 0) {
+                for (SpellAbility x = sa; x != null; x = x.getSubAbility()) {
+                    if (x.getApi() == ApiType.Token) {
+                        tokenSa = x;
+                        break;
+                    }
+                }
+                if (tokenSa == null) {
+                    return false;   // tokens from elsewhere (a trigger): step by step
+                }
+                final int gapStep = -d[S_GAP];
+                final int need = s[S_GAP] <= 0 ? 0 : gapStep > 0 ? (s[S_GAP] + gapStep - 1) / gapStep : Integer.MAX_VALUE;
+                final int room = Math.max(0, (LOOP_BOARD_CAP - s[S_CREATURES]) / d[S_TOKENS]);
+                n = Math.min(need, room);
+                tokenReason = need <= room ? "goal" : "board";
+            }
+            boolean drawBound = false;
+            if (d[S_LIB] < 0) {
+                // with a card that wins from an empty library (Thassa's Oracle) it draws down to one card when that card can
+                // be cast right after (own main phase, its mana open: the loop is free), or to two in the turn just before
+                // the seat's own (its draw step takes one; Forge casts these instant-speed loops on other players' turns);
+                // otherwise to the floor, and the loop can run again later
+                final forge.game.phase.PhaseHandler ph = game.getPhaseHandler();
+                final boolean ownMain = ph.isPlayerTurn(player) && ph.getPhase().isMain();
+                final boolean turnBefore = !ph.isPlayerTurn(player) && player.equals(ph.getNextTurn());
+                int keep = LOOP_LIBRARY_FLOOR;
+                for (final Card c : com.google.common.collect.Iterables.concat(player.getCardsIn(ZoneType.Hand), player.getCardsIn(ZoneType.Library))) {
+                    if (!forge.ai.ability.DrawAi.emptyLibraryWinCard(c)) {
+                        continue;
+                    }
+                    if (ownMain && getAvailableManaEstimate(player, true) >= c.getCMC()) {
+                        keep = 1;
+                        break;
+                    }
+                    if (turnBefore && getAvailableManaEstimate(player, false) >= c.getCMC()) {
+                        keep = 2;
+                    }
+                }
+                final int drawMax = Math.max(0, (s[S_LIB] - keep) / (-d[S_LIB]));
+                drawBound = drawMax <= n;
+                n = Math.min(n, drawMax);
+            }
+            if (n == Integer.MAX_VALUE) {
+                return false;
+            }
+            cycles = n;
+            if (n > 0 && tokenSa != null) {
+                final Set<Card> before = new HashSet<>(player.getCardsIn(ZoneType.Battlefield));
+                final SpellAbility batch = tokenSa.copy(tokenSa.getHostCard(), player, false);
+                final int per = AbilityUtils.calculateAmount(tokenSa.getHostCard(), tokenSa.getParamOrDefault("TokenAmount", "1"), tokenSa);
+                batch.putParam("TokenAmount", String.valueOf(per * n));
+                batch.setSubAbility(null);
+                batch.getApi().getSpellEffect().resolve(batch);
+                final List<Card> fresh = new ArrayList<>();
+                for (final Card c : player.getCardsIn(ZoneType.Battlefield)) {
+                    if (!before.contains(c) && c.isToken()) {
+                        fresh.add(c);
+                    }
+                }
+                made = fresh.size();
+                // the iterations tapped as many creatures as they didn't leave untapped (convoke)
+                int tap = Math.max(0, (d[S_TOKENS] - d[S_UNTAPPED]) * n);
+                for (final Card c : fresh) {
+                    if (tap-- <= 0) {
+                        break;
+                    }
+                    if (c.isCreature()) {
+                        c.setTapped(true);
+                    }
+                }
+            }
+            if (n > 0 && d[S_LIB] < 0) {
+                drawn = player.drawCards(-d[S_LIB] * n, sa, null).size();
+            }
+            game.getAction().checkStateEffects(true);
+            reason = drawBound ? "library" : tokenReason != null ? tokenReason : "jumped";
+        }
+        System.out.println("#FP-LOOP {\"event\": \"jump\", \"player\": \"" + player.getName() + "\", \"turn\": " + ls.turn
+                + ", \"play\": \"" + sa.getHostCard().getName() + "\", \"cycles\": " + cycles + ", \"tokens\": " + made
+                + ", \"drawn\": " + drawn + ", \"reason\": \"" + reason + "\"}");
+        ls.jumped = true;
+        stopLoop(ls, sa, key, reason, "goal".equals(reason) || "lethal".equals(reason));
+        return true;
+    }
