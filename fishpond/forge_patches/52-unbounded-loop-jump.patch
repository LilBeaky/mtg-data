+    private static boolean inSimulation() {
+        for (final StackTraceElement e : Thread.currentThread().getStackTrace()) {
+            if (e.getClassName().startsWith("forge.ai.simulation")) {
+                return true;
+            }
+        }
+        return false;
+    }
