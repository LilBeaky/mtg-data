+    // ---- fishpond patch 73: transmute (the user, 2026-10-18: "Brainspoil shouldn't have been hardcast ... encourage activating
+    // the transmute rather than casting the actual spell"). A card with transmute is a tutor first: its spell is cast only in an
+    // emergency (an opponent a turn from winning: EMERGENCY, the harness's threat model) or, for a counterspell, against a spell
+    // the threat model rates 60+; otherwise the turn plan plans its transmute (TurnPlan.transmuteOf). A card with nothing of its
+    // mana value left in the library is just a spell.
+    public static volatile java.util.function.Predicate<Player> EMERGENCY;
+
+    static boolean emergency(final Player p) {
+        final java.util.function.Predicate<Player> f = EMERGENCY;
+        try {
+            return f != null && f.test(p);
+        } catch (final RuntimeException e) {
+            return false;
+        }
+    }
+
+    private boolean transmuteInstead(final SpellAbility sa) {
+        if (sa == null || !sa.isSpell() || sa.getHostCard() == null || TurnPlan.transmuteOf(player, sa.getHostCard()) == null
