+    /** fishpond patch 62: a board wipe is considered before the turn's other spells. Wilson's wipes were judged worth
+     *  casting (patch 60) on 26 turns of a 20-game pod and cast on 5: the mana went first to the creatures and enchantments
+     *  the wipe would then have killed. Wipe first, then develop; a wipe judged not worth it leaves the order as it was. */
+    private boolean wipeFirst(final SpellAbility sa) {
+        if (!ComputerUtilCard.Wipe.applies(player, sa) || sa.getHostCard() == null) {
+            return false;
+        }
+        for (SpellAbility x = sa; x != null; x = x.getSubAbility()) {
+            if (ComputerUtilCard.Wipe.isWipe(x)) {
+                return true;
+            }
+        }
+        if (sa.getApi() == ApiType.Charm) {
+            final List<forge.game.spellability.AbilitySub> choices = forge.game.ability.effects.CharmEffect.makePossibleOptions(sa);
+            boolean all = !choices.isEmpty();
+            for (final forge.game.spellability.AbilitySub c : choices) {
+                all &= ComputerUtilCard.Wipe.isWipe(c);
+            }
+            return all;
+        }
+        return sa.isSpell() && sa.getHostCard().hasStartOfKeyword("Overload");
+    }
