+    // ---- fishpond patch 22: the block planner asks for every attacker/blocker pair what pumps, destroy and damage
+    // triggers could fire, and each ask rebuilt the list of every trigger on every permanent (and command-zone card):
+    // most of a combat prediction on a big board (JFR, 30 creatures a side, 2026-10-07). While a combat is being
+    // planned (beginCombatPlan/endCombatPlan around AiAttackController.declareAttackers, AiBlockController.
+    // assignBlockersForCombat and ComputerUtil's next-combat prediction) the board doesn't change, so each game's list
+    // is built once, keeping only the modes combatTriggerWillTrigger accepts (it rejects every other mode first), in
+    // the original order. Outside a plan, or with -Dfishpond.combatPlanCache=false, the lists are built as before.
+    private static final boolean PLAN_CACHE = !"false".equals(System.getProperty("fishpond.combatPlanCache"));
+
+    private static final class CombatPlan {
+        int depth;
+        final Map<Game, FCollection<Trigger>> withCommand = new java.util.HashMap<>();
+        final Map<Game, FCollection<Trigger>> battlefieldOnly = new java.util.HashMap<>();
+    }
+
+    private static final ThreadLocal<CombatPlan> PLAN = new ThreadLocal<>();
+
+    public static void beginCombatPlan() {
+        if (!PLAN_CACHE) {
+            return;
+        }
+        CombatPlan p = PLAN.get();
+        if (p == null) {
+            p = new CombatPlan();
+            PLAN.set(p);
+        }
+        p.depth++;
+    }
+
+    public static void endCombatPlan() {
+        final CombatPlan p = PLAN.get();
+        if (p != null && --p.depth <= 0) {
+            PLAN.remove();
+        }
+    }
+
+    private static boolean combatMode(final Trigger t) {
+        final TriggerType mode = t.getMode();
+        return mode == TriggerType.Attacks || mode == TriggerType.AttackerUnblocked || mode == TriggerType.Blocks
+                || mode == TriggerType.AttackerBlocked || mode == TriggerType.AttackerBlockedByCreature || mode == TriggerType.DamageDone;
+    }
+
+    private static FCollection<Trigger> combatTriggers(final Game game, final boolean withCommand) {
+        final CombatPlan p = PLAN.get();
+        if (p == null) {
+            final FCollection<Trigger> all = new FCollection<>();
+            for (Card card : game.getCardsIn(ZoneType.Battlefield)) {
+                all.addAll(card.getTriggers());
+            }
+            if (withCommand) {
+                for (Card card : game.getCardsIn(ZoneType.Command)) {
+                    all.addAll(card.getTriggers());
+                }
+            }
+            return all;
+        }
+        final Map<Game, FCollection<Trigger>> m = withCommand ? p.withCommand : p.battlefieldOnly;
+        FCollection<Trigger> cached = m.get(game);
+        if (cached == null) {
+            cached = new FCollection<>();
+            for (Card card : game.getCardsIn(ZoneType.Battlefield)) {
+                for (final Trigger t : card.getTriggers()) {
+                    if (combatMode(t)) {
+                        cached.add(t);
+                    }
+                }
+            }
+            if (withCommand) {
+                for (Card card : game.getCardsIn(ZoneType.Command)) {
+                    for (final Trigger t : card.getTriggers()) {
+                        if (combatMode(t)) {
+                            cached.add(t);
+                        }
+                    }
+                }
+            }
+            m.put(game, cached);
+        }
+        return new FCollection<>(cached);
+    }
