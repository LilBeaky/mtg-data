+    /** fishpond patch 32: a -X/-X wipe whose X is paid in life (Toxic Deluge), cast by a pilot seat. Forge never chose X for
+     *  it, so X stayed 0 and the wipe did nothing. */
+    public static boolean pilotLifeXApplies(final Player ai, final SpellAbility sa) {
+        final Cost c = sa.getPayCosts();
+        return sa.getApi() == forge.game.ability.ApiType.PumpAll && sa.isCurse() && DrawAi.pilotSeat(ai) && "-X".equals(sa.getParam("NumDef"))
+                && "Count$xPaid".equals(sa.getSVar("X")) && c != null && c.getCostParts().stream().anyMatch(p -> p instanceof forge.game.cost.CostPayLife);
+    }
+
+    /** The smallest X that kills the most opposing value (every opponent) net of the seat's own losses, spending at most half
+     *  its life and keeping 10; 0 when no X is worth it. */
+    public static int pilotLifeX(final Player ai, final SpellAbility sa) {
+        final Card source = sa.getHostCard();
+        final String valid = sa.getParamOrDefault("ValidCards", "Creature");
+        final int budget = Math.min(ai.getLife() - 10, ai.getLife() / 2);
+        final CardCollection mine = CardLists.getValidCards(ai.getCardsIn(ZoneType.Battlefield), valid, ai, source, sa);
+        final CardCollection theirs = new CardCollection();
+        for (final Player o : ai.getOpponents()) {
+            theirs.addAll(CardLists.getValidCards(o.getCardsIn(ZoneType.Battlefield), valid, ai, source, sa));
+        }
+        int bestX = 0, bestScore = 149;
+        for (int x = 1; x <= budget; x++) {
+            int score = 0;
+            for (final Card c : theirs) {
+                if (c.getNetToughness() <= x) {
+                    score += ComputerUtilCard.evaluateCreature(c);
+                }
+            }
+            for (final Card c : mine) {
+                if (c.getNetToughness() <= x) {
+                    score -= ComputerUtilCard.evaluateCreature(c);
+                }
+            }
+            if (score > bestScore) {
+                bestScore = score;
+                bestX = x;
+            }
+        }
+        return bestX;
+    }
 }
