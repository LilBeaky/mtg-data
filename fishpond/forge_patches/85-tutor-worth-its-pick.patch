+    /** The library search in sa's chain, or in its card's "when this enters" trigger: a hidden-origin ChangeZone from the
+     *  library into hand, onto the battlefield or onto the library top, for nonland cards. */
+    static SpellAbility search(final SpellAbility sa) {
+        for (SpellAbility x = sa; x != null; x = x.getSubAbility()) {
+            if (isSearch(x)) return x;
+        }
+        return null;
+    }
+
+    static boolean isSearch(final SpellAbility x) {
+        if (x.getApi() != ApiType.ChangeZone || !x.getParamOrDefault("Origin", "").contains("Library") || x.hasParam("Defined")
+                || !x.hasParam("ChangeType")) {
+            return false;
+        }
+        final String dest = x.getParamOrDefault("Destination", "");
+        if (!dest.equals("Hand") && !dest.equals("Battlefield") && !dest.equals("Library")) {
+            return false;
+        }
+        for (final String t : x.getParam("ChangeType").split(",")) {
+            if (!t.startsWith("Land") && !t.startsWith("Basic") && !t.startsWith("Plains") && !t.startsWith("Island")
+                    && !t.startsWith("Swamp") && !t.startsWith("Mountain") && !t.startsWith("Forest")) return true;
+        }
+        return false;   // a land search is ramp
+    }
+
+    static SpellAbility etbSearch(final Card c) {
+        if (!c.isPermanent()) {
+            return null;
+        }
+        for (final forge.game.trigger.Trigger t : c.getTriggers()) {
+            if (t.getMode() != forge.game.trigger.TriggerType.ChangesZone || !"Battlefield".equals(t.getParam("Destination"))
+                    || !t.getParamOrDefault("ValidCard", "").startsWith("Card.Self")) continue;
+            try {
+                final SpellAbility x = search(t.ensureAbility());
+                if (x != null) return x;
+            } catch (final RuntimeException e) { /* skip */ }
+        }
+        return null;
+    }
