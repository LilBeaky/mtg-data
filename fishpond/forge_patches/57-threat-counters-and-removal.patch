@@ -4109,6 +4109,48 @@ public class AiController {
         return false;
     }
 
+    // ---- fishpond patch 57: threat assessment, phase 2 (the user, 2026-10-16) ----
+    // The harness's threat model (ThreatModel.java: every deck's list, the battlefield, graveyards and hand counts, no hidden
+    // card) answers two questions for pilot seats: how much removing a permanent matters (cardThreat, 0-100: its controller's
+    // threat relative to the viewer's other opponents, times its role: combo piece, engine links and cycles, commander, big
+    // mana, clock, key card) and how much countering a spell matters (spellThreat, 0-100: a win effect 100, completing a combo,
+    // a key card, engine links, the commander, a big spell, a mass removal, times the caster's relative threat). Removal
+    // targets add 4 x cardThreat to Forge's own priority (ComputerUtilCard.evaluateRemovalTargetPriority); counterspells
+    // counter at spellThreat THREAT_COUNTER_AT or more and keep the counter below THREAT_SAVE_BELOW unless the spell hits the
+    // seat itself (CounterAi); single-target removal is used now on a target at THREAT_REMOVE_NOW or more instead of being
+    // held (ComputerUtilCard.useRemovalNow). Simulated games: no harness controllers, so the hooks answer 0. -Dfishpond.threatPlay=false
+    // turns both off.
+    public static volatile java.util.function.ToDoubleBiFunction<Player, Card> CARD_THREAT;
+    public static volatile java.util.function.ToDoubleBiFunction<Player, SpellAbility> SPELL_THREAT;
+    static final boolean THREAT_PLAY = !"false".equals(System.getProperty("fishpond.threatPlay"));
+    public static final double THREAT_COUNTER_AT = Double.parseDouble(System.getProperty("fishpond.threatCounterAt", "50"));
+    public static final double THREAT_SAVE_BELOW = Double.parseDouble(System.getProperty("fishpond.threatSaveBelow", "20"));
+    public static final double THREAT_REMOVE_NOW = Double.parseDouble(System.getProperty("fishpond.threatRemoveNow", "40"));
+
+    public static double cardThreatOf(final Player viewer, final Card c) {
+        final java.util.function.ToDoubleBiFunction<Player, Card> f = CARD_THREAT;
+        if (!THREAT_PLAY || f == null || viewer == null || c == null || !forge.ai.ability.DrawAi.pilotSeat(viewer)) {
+            return 0;
+        }
+        try {
+            return f.applyAsDouble(viewer, c);
+        } catch (final RuntimeException e) {
+            return 0;
+        }
+    }
+
+    public static double spellThreatOf(final Player viewer, final SpellAbility sa) {
+        final java.util.function.ToDoubleBiFunction<Player, SpellAbility> f = SPELL_THREAT;
+        if (!THREAT_PLAY || f == null || viewer == null || sa == null || !forge.ai.ability.DrawAi.pilotSeat(viewer)) {
+            return -1;
+        }
+        try {
+            return f.applyAsDouble(viewer, sa);
+        } catch (final RuntimeException e) {
+            return -1;
+        }
+    }
+
     // The deck's plan, from the harness (PilotPolicy.castPriority: completes a combo 3, turns an engine on 2, feeds one 1),
     // for pilot seats in the real game; simulated games have no policy and get 0.
     public static volatile java.util.function.ToIntBiFunction<Player, SpellAbility> CAST_PRIORITY;
