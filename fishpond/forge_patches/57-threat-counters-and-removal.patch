 public class CounterAi extends SpellAbilityAi {
 
+    /** fishpond patch 57: the spell targets ai or its permanents, or wipes the board ai is on. */
+    static boolean hitsSeat(final Player ai, final SpellAbility tgt) {
+        for (SpellAbility x = tgt; x != null; x = x.getSubAbility()) {
+            for (final forge.game.GameObject o : x.getTargets()) {
+                if (o == ai || (o instanceof Card && ((Card) o).getController() == ai)) {
+                    return true;
+                }
+            }
+            final ApiType api = x.getApi();
+            if (api == ApiType.DestroyAll || api == ApiType.DamageAll || api == ApiType.SacrificeAll
+                    || (api == ApiType.ChangeZoneAll && "Battlefield".equals(x.getParam("Origin")))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
