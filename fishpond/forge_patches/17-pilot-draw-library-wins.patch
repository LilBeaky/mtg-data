+    // ---- fishpond patch 17: Approach of the Second Sun goes 7th from the top after its first cast, and the second cast from
+    // hand wins. Zur's attack trigger, tutors, wizardcycling and fetchlands all shuffle the library and bury it (varied pods
+    // 2026-10-07: Zur drew 9 and 11 cards after a first Approach and never saw it again). A pilot seat doesn't search its own
+    // library while such a card sits in its top 7. Read from the card's script (a cast trigger that creates a command-zone
+    // effect, and a spell that can win the game), not its name.
+    public static boolean shufflesAwayKnownWin(final Player ai, final SpellAbility sa) {
+        if (!DrawAi.pilotSeat(ai) || !sa.hasParam("Origin") || !ZoneType.listValueOf(sa.getParam("Origin")).contains(ZoneType.Library)) {
+            return false;
+        }
+        final String who = sa.getParamOrDefault("DefinedPlayer", "You");
+        if (!"You".equals(who)) {
+            return false;                                  // searching someone else's library
+        }
+        final CardCollectionView lib = ai.getCardsIn(ZoneType.Library);
+        for (int i = 0; i < Math.min(7, lib.size()); i++) {
+            if (secondCastWins(ai, lib.get(i))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** c wins when cast again: its cast trigger made an effect the player already has (Approach's "ApproachingSuns"), and its
+     *  spell holds a WinsGame branch. */
+    private static boolean secondCastWins(final Player ai, final Card c) {
+        boolean wins = false;
+        for (final SpellAbility sp : c.getSpells()) {
+            for (SpellAbility a = sp; a != null; a = a.getSubAbility()) {
+                if (a.getApi() == ApiType.WinsGame || a.getApi() == ApiType.Branch && (c.getSVar(a.getParamOrDefault("TrueSubAbility", "")).contains("WinsGame") || c.getSVar(a.getParamOrDefault("FalseSubAbility", "")).contains("WinsGame"))) {
+                    wins = true;
+                }
+            }
+        }
+        if (!wins) {
+            return false;
+        }
+        for (final forge.game.trigger.Trigger t : c.getTriggers()) {
+            if (t.getMode() != forge.game.trigger.TriggerType.SpellCast) {
+                continue;
+            }
+            final SpellAbility eff = t.ensureAbility();
+            if (eff != null && eff.getApi() == ApiType.Effect && eff.hasParam("Name")) {
+                for (final Card e : ai.getCardsIn(ZoneType.Command)) {
+                    if (eff.getParam("Name").equals(e.getName())) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
