+        // fishpond patch 17: draw the whole library, then put cards back (Enter the Infinite). Nothing decks this turn and
+        // the next draw step takes a card put back, so the AI has a full turn with its library in hand. Worth it when the
+        // win is among those cards: one that wins when it enters with a tiny library (Thassa's Oracle) or a permanent that
+        // wins on an empty-library draw (Laboratory Maniac, Jace), castable with the mana the AI has now (this turn or
+        // next), or a creature already out that wins on attack with a full hand (Twenty-Toed Toad). The put-back never
+        // takes such a card (ChangeZoneAi, patch 17).
+        if (back > 0 && drawn >= lib) {
+            final int mana = ComputerUtilMana.getAvailableManaEstimate(ai, false);
+            final java.util.List<Card> pool = new java.util.ArrayList<>(ai.getCardsIn(ZoneType.Hand));
+            pool.addAll(ai.getCardsIn(ZoneType.Library));
+            for (final Card c : pool) {
+                if (c != source && emptyLibraryWinCard(c) && (castFree(ai, c) || c.getManaCost().getCMC() <= mana)) {
+                    return true;
+                }
+            }
+            for (final Card c : ai.getCreaturesInPlay()) {
+                if (hasWinTrigger(c, TriggerType.Attacks)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** A card that wins when it enters with a tiny library (Thassa's Oracle) or wins on an empty-library draw while it is
+     *  on the battlefield (Laboratory Maniac, Jace, Wielder of Mysteries). Fishpond patch 17. */
+    public static boolean emptyLibraryWinCard(final Card c) {
+        if (hasWinTrigger(c, TriggerType.ChangesZone)) {
+            return true;
+        }
+        for (final forge.game.replacement.ReplacementEffect re : c.getReplacementEffects()) {
+            if (re.getMode() == forge.game.replacement.ReplacementType.Draw && re.hasParam("ReplaceWith")) {
+                final SpellAbility rsa = re.ensureAbility();
+                if (rsa != null && rsa.getApi() == ApiType.WinsGame) {
+                    return true;
+                }
+            }
+        }
         return false;
     }
 
