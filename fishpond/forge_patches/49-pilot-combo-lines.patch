+        }
+        for (SpellAbility x = sa; x != null && !wins; x = x.getSubAbility()) {
+            wins = x.getApi() == ApiType.WinsGame;
+        }
+        return wins && ComputerUtilCard.checkNeedsToPlayReqs(c, sa) == AiPlayDecision.WillPlay;
+    }
