 public class EffectAi extends SpellAbilityAi {
+    // ---- fishpond patch 98: Words of Worship ("{1}: The next time you would draw a card this turn, you gain 5 life instead";
+    // Forge had no AI for it, a known gap; the user, 2026-10-23: "Could've crawled some life back with Words of Worship";
+    // "Fix Words of Worship if you can"). A pilot seat makes a shield when its life is under 20 (or in danger) and one of its
+    // own draws is coming that its shields don't cover: a draw of its on the stack, its own draw step from the upkeep when
+    // nothing skips it, or, in its main 2, Necrodominance's end-step "pay any amount of life, draw that many" (the AI isn't
+    // asked while that trigger is on the stack; counted as up to six, and DrawAi then pays at least one life per shield:
+    // +4 life each). ----
+    static final int SHIELD_LIFE = 20;
+
+    /** sa makes an effect that replaces its controller's next draw with life (Words of Worship). */
+    public static boolean drawToLife(final SpellAbility sa) {
+        if (sa == null || sa.getApi() != ApiType.Effect || !sa.hasParam("ReplacementEffects") || sa.getHostCard() == null) return false;
+        for (final String r : sa.getParam("ReplacementEffects").split(",")) {
+            final String re = sa.getHostCard().getSVar(r.trim());
+            if (!re.contains("Event$ Draw")) continue;
+            final java.util.regex.Matcher m = java.util.regex.Pattern.compile("ReplaceWith\\$ (\\w+)").matcher(re);
+            if (m.find() && sa.getHostCard().getSVar(m.group(1)).contains("GainLife")) return true;
+        }
+        return false;
+    }
+
+    /** The seat's live shields: effects in its command zone that replace a draw of its with life. */
+    public static int drawShields(final Player ai) {
+        int n = 0;
+        for (final Card k : ai.getCardsIn(ZoneType.Command)) {
+            for (final ReplacementEffect re : k.getReplacementEffects()) {
+                if (re.getMode() != ReplacementType.Draw) continue;
+                final SpellAbility over = re.getOverridingAbility();
+                if (over != null && over.getApi() == ApiType.GainLife) n++;
+            }
+        }
+        return n;
+    }
+
+    static boolean shieldNow(final Player ai) {
+        if (ai.getLife() >= SHIELD_LIFE && !ComputerUtil.aiLifeInDanger(ai, false, 0)) return false;
+        return pendingDraws(ai) > drawShields(ai);
+    }
+
+    /** Draws of the seat's own coming this turn: its draws on the stack, and its draw step from the upkeep. */
+    static int pendingDraws(final Player ai) {
+        final Game game = ai.getGame();
+        int n = 0;
+        for (final SpellAbilityStackInstance si : game.getStack()) {
+            final SpellAbility top = si.getSpellAbility();
+            if (top == null || top.getActivatingPlayer() != ai) continue;
+            for (SpellAbility x = top; x != null; x = x.getSubAbility()) {
+                if (x.getApi() != ApiType.Draw) continue;
+                final String def = x.getParamOrDefault("Defined", "You");
+                if (!def.equals("You")) continue;
+                final String num = x.getParamOrDefault("NumCards", "1");
+                if (num.equals("X") && x.getPayCosts() != null && x.getPayCosts().hasSpecificCostType(forge.game.cost.CostPayLife.class)) {
+                    n += Math.max(0, Math.min(6, ai.getLife() - 1));
+                } else {
+                    try { n += Math.max(0, AbilityUtils.calculateAmount(x.getHostCard(), num, x)); } catch (final RuntimeException e) { n += 1; }
+                }
+            }
+        }
+        final PhaseHandler ph = game.getPhaseHandler();
+        if (ph.isPlayerTurn(ai) && ph.is(PhaseType.UPKEEP) && !skipsDrawStep(ai)) n++;
+        // its own end step's pay-life draw (Necrodominance): the AI isn't asked while that trigger is on the stack, and the
+        // shields last the turn, so they're made in main 2
+        if (ph.isPlayerTurn(ai) && ph.is(PhaseType.MAIN2) && forge.ai.TurnPlan.lifeDraw(ai)) n += Math.max(0, Math.min(6, ai.getLife() - 1));
+        return n;
+    }
+
+    static boolean skipsDrawStep(final Player ai) {
+        for (final Card k : ai.getCardsIn(ZoneType.Battlefield)) {
+            for (final ReplacementEffect re : k.getReplacementEffects()) {
+                if (re.getMode() == ReplacementType.BeginPhase && "Draw".equals(re.getParam("Phase")) && "True".equals(re.getParam("Skip"))) return true;
+            }
+        }
+        return false;
+    }
