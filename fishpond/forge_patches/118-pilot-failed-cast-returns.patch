+    // ---- fishpond patch 118: a cast whose payment failed (its card back in the zone it came from) isn't tried again this phase ----
+    static final Map<Player, Object[]> FAILED = Collections.synchronizedMap(new WeakHashMap<>());
+
+    public static void failedCast(final Player ai, final Card c) {
+        if (ai == null || c == null) return;
+        final String pk = phaseKey(ai);
+        Object[] d = FAILED.get(ai);
+        if (d == null || !pk.equals(d[0])) { d = new Object[] {pk, new HashSet<Integer>()}; FAILED.put(ai, d); }
+        @SuppressWarnings("unchecked") final Set<Integer> ids = (Set<Integer>) d[1];
+        ids.add(c.getId());
+        CACHE.remove(ai);
+    }
+
+    public static boolean castFailedThisPhase(final Player ai, final Card c) {
+        final Object[] d = ai == null || c == null ? null : FAILED.get(ai);
+        return d != null && phaseKey(ai).equals(d[0]) && ((Set<?>) d[1]).contains(c.getId());
+    }
