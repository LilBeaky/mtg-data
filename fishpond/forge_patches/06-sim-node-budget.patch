+    // hours for one decision). Past this many simulated plays (-Dfishpond.simMaxNodes, default 1000; 0 = no limit) a
+    // decision stops looking deeper: the plays left are still each simulated once and scored, so the search narrows
+    // instead of falling back. Counts plays, not time, so a seed replays the same.
+    static final int MAX_NODES = Integer.getInteger("fishpond.simMaxNodes", 1000);
+    private int simulations = 0;
+
+    public void countSimulation() {
